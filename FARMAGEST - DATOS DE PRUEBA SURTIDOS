    ('Mónica'),('Facundo');

DECLARE @Apellidos TABLE (apellido VARCHAR(80));
INSERT INTO @Apellidos VALUES ('González'),('Romero'),('Sosa'),('Ramírez'),('Acosta'),('Benítez'),('Duarte'),
    ('Ojeda'),('Vallejos'),('Aquino'),('Cáceres'),('Fernández'),('Gómez'),('Insaurralde'),('Medina'),('Leiva'),
