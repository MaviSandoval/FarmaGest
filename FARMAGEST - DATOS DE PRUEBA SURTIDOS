    ('IOSCOR', 'Adherentes',  'Grupo familiar adherente',        30),
    ('PAMI',   'Jubilados',   'Jubilados y pensionados',         80),
    ('OSDE',   'Activos',     'Plan 310',                        50),
    ('OSDE',   'Jubilados',   'Plan 410',                        70),
    ('OSDE',   'Adherentes',  'Plan 210',                        40),
    ('SWISS',  'Activos',     'Plan SMG20',                      50),
    ('SWISS',  'Adherentes',  'Plan SMG10',                      35),
    ('OSECAC', 'Activos',     'Empleados de comercio',           40),
    ('OSECAC', 'Jubilados',   'Jubilados de comercio',           60),
