/* =====================================================================
   FARMAGEST - DATOS DE PRUEBA SURTIDOS (lote para los reportes)
   ---------------------------------------------------------------------
   Taller de Programación II - FaCENA UNNE - 2026 - Grupo 23
   Motor: SQL Server

   Solo AGREGA movimiento usando lo que ya existe en la base:
   no crea usuarios, productos, obras sociales ni afiliados, y no borra nada.

   1. ACTIVIDAD (últimos @Dias días, hasta ayer)
      - Turnos de caja: el día (08:00 a 20:00) se reparte entre los cajeros
        activos; cada cobro cae en la caja del turno. Cierre con arqueo y
        algunas diferencias.
      - Más ventas de lunes a viernes, menos sábados y domingos, picos a
        principio de mes y una leve tendencia de crecimiento.
      - ~40 % con receta (con la cobertura del plan del afiliado), ~5 % anuladas.
      - Productos con distinta popularidad: hay "más vendidos" claros.
      - Algunas recetas rechazadas.
      - Medios de pago: Efectivo (con vuelto), Débito, Crédito, Transferencia,
        con el detalle de tarjeta o transferencia.

   2. RECETAS DE HOY (para la Nueva venta y las notificaciones)
      - Pendientes de validar, validadas sin usar, por vencer (2-3 días) y vencidas.

   3. MOVIMIENTO DE HOY (para Preventas, Resumen de caja y Mis ventas)
      - Una caja abierta del primer cajero (si no tiene una).
      - 4 ventas cobradas hoy (efectivo, débito, transferencia, crédito).
      - Preventas sin cobrar: 2 de venta libre y 1 con receta. Como en la app,
        estas reservan stock (se descuenta al enviarlas a caja).

   REQUISITOS: al menos un cajero y un farmacéutico activos y productos de
   venta libre. Para las ventas con receta hacen falta afiliados activos y
   productos con receta (si no hay, solo genera ventas libres).

   IMPORTANTE:
     - Generá antes una copia de seguridad desde Configuración.
     - Requiere el SCRIPT DE ACTUALIZACIÓN aplicado (tablas Cobro y MedioPago).
     - Si se ejecuta dos veces, la actividad histórica se suma a la anterior
       (las secciones 2 y 3 no se repiten en el mismo día).
     - Si algo falla, se deshace todo.
   ===================================================================== */

USE FarmaGestDB;
GO

SET NOCOUNT ON;

DECLARE @Dias                INT = 120;

BEGIN TRY
BEGIN TRANSACTION;

/* =====================================================================
   1. ACTIVIDAD HISTÓRICA
   ===================================================================== */

DECLARE @hoy DATE = CAST(GETDATE() AS DATE);
DECLARE @desde DATE = DATEADD(DAY, -@Dias, @hoy);

DECLARE @generar BIT = 1;

IF @generar = 1
BEGIN
    -- ---------- Participantes ----------
    DECLARE @Cajeros TABLE (n INT IDENTITY(1,1), id INT);
    INSERT INTO @Cajeros (id)
    SELECT u.id_usuario FROM Usuario u JOIN Rol r ON r.id_rol = u.id_rol
    WHERE r.nombre = 'Cajero' AND u.estado = 1 ORDER BY u.id_usuario;

    -- Farmacéuticos con distinto "peso": unos venden más que otros
    DECLARE @Farmaceuticos TABLE (id INT, peso FLOAT);
    INSERT INTO @Farmaceuticos (id, peso)
    SELECT u.id_usuario, 1 + ROW_NUMBER() OVER (ORDER BY u.id_usuario) % 3
    FROM Usuario u JOIN Rol r ON r.id_rol = u.id_rol
    WHERE r.nombre = 'Farmaceutico' AND u.estado = 1;

    -- Popularidad de 1 a 6: los productos baratos y de uso diario se venden más
    DECLARE @Libres TABLE (id INT, precio DECIMAL(10,2), peso FLOAT);
    INSERT INTO @Libres (id, precio, peso)
    SELECT id_producto, precioVenta,
           CASE WHEN precioVenta < 3000 THEN 6 WHEN precioVenta < 5000 THEN 4
                WHEN precioVenta < 10000 THEN 2 ELSE 1 END + id_producto % 2
    FROM Producto WHERE estado = 1 AND requiereReceta = 0;

    DECLARE @Recetados TABLE (id INT, peso FLOAT);
    INSERT INTO @Recetados (id, peso)
    SELECT id_producto, 1 + id_producto % 4
    FROM Producto WHERE estado = 1 AND requiereReceta = 1;

    DECLARE @Afiliados TABLE (n INT IDENTITY(1,1), id INT, idPlan INT);
    INSERT INTO @Afiliados (id, idPlan)
    SELECT id_afiliado, idPlan FROM Afiliados WHERE activo = 1;

    DECLARE @Medicos TABLE (n INT IDENTITY(1,1), nombre VARCHAR(120), matricula VARCHAR(30));
    INSERT INTO @Medicos (nombre, matricula) VALUES
        ('Dra. Laura Gómez', 'MP 12345'), ('Dr. Ricardo Benítez', 'MP 20451'),
        ('Dra. Paula Sosa', 'MP 18733'),  ('Dr. Martín Acosta', 'MP 22019'),
        ('Dr. Esteban Quiroga', 'MP 19872'), ('Dra. Silvina Romero', 'MP 21544'),
        ('Dr. Alejandro Vera', 'MP 23310'), ('Dra. Natalia Pereyra', 'MP 17650');

    DECLARE @nCajeros INT = (SELECT COUNT(*) FROM @Cajeros),
            @nFarma   INT = (SELECT COUNT(*) FROM @Farmaceuticos),
            @nLibres  INT = (SELECT COUNT(*) FROM @Libres),
            @nRecet   INT = (SELECT COUNT(*) FROM @Recetados),
            @nAfil    INT = (SELECT COUNT(*) FROM @Afiliados),
            @nMed     INT = (SELECT COUNT(*) FROM @Medicos);

    IF @nCajeros = 0 OR @nFarma = 0 OR @nLibres = 0
        THROW 50001, 'Faltan cajeros activos, farmacéuticos activos o productos de venta libre.', 1;

    DECLARE @turno INT = 720 / @nCajeros;   -- minutos de cada turno de caja

    DECLARE @dia INT = @Dias, @fecha DATE, @c INT, @v INT, @ventasDia INT, @dow INT,
            @cajero INT, @caja INT, @farma INT, @hora DATETIME, @cobro DATETIME, @min INT,
            @conReceta BIT, @anulada BIT, @afiliado INT, @plan INT,
            @receta INT, @emision DATE, @medico VARCHAR(120), @matricula VARCHAR(30),
            @venta INT, @extra INT, @importe DECIMAL(10,2), @r INT,
            @medio VARCHAR(30), @vuelto DECIMAL(10,2), @cobroId INT;

    DECLARE @CajasDia TABLE (n INT, id_caja INT, id_usuario INT);

    WHILE @dia >= 1
    BEGIN
        SET @fecha = DATEADD(DAY, -@dia, @hoy);
        SET @dow = (DATEPART(WEEKDAY, @fecha) + @@DATEFIRST) % 7;   -- 1 = domingo, 0 = sábado (sin depender del idioma)
        DELETE FROM @CajasDia;

        -- 1.1 Un turno de caja por cajero (08:00 a 20:00 repartido)
        SET @c = 1;
        WHILE @c <= @nCajeros
        BEGIN
            SELECT @cajero = id FROM @Cajeros WHERE n = @c;

            INSERT INTO Caja (fecha_apertura, monto_inicial, estado, id_usuario)
            VALUES (DATEADD(MINUTE, 480 + (@c - 1) * @turno, CAST(@fecha AS DATETIME)),
                    CASE WHEN @c = 1 THEN 20000 ELSE 15000 END, 1, @cajero);

            INSERT INTO @CajasDia VALUES (@c, SCOPE_IDENTITY(), @cajero);
            SET @c += 1;
        END

        -- 1.2 Cantidad de ventas: base + tendencia + principio de mes - fin de semana
        SET @ventasDia = 7 + ABS(CHECKSUM(NEWID())) % 8 + (@Dias - @dia) / 30;
        IF DAY(@fecha) <= 5 SET @ventasDia += 4;
        IF @dow = 0 SET @ventasDia = @ventasDia * 3 / 4;
        IF @dow = 1 SET @ventasDia = @ventasDia / 2;

        SET @v = 1;
        WHILE @v <= @ventasDia
        BEGIN
            SET @hora = DATEADD(MINUTE, 480 + ABS(CHECKSUM(NEWID())) % 680, CAST(@fecha AS DATETIME));  -- 08:00 a 19:20

            -- Farmacéutico elegido según su peso
            SELECT TOP 1 @farma = id FROM @Farmaceuticos
            ORDER BY -LOG(1 - RAND(CHECKSUM(NEWID())) * 0.999999) / peso;

            SET @conReceta = CASE WHEN @nAfil > 0 AND @nRecet > 0 AND ABS(CHECKSUM(NEWID())) % 100 < 40 THEN 1 ELSE 0 END;
            SET @anulada   = CASE WHEN ABS(CHECKSUM(NEWID())) % 100 < 5 THEN 1 ELSE 0 END;
            SET @receta = NULL;

            IF @conReceta = 1
            BEGIN
                SELECT @afiliado = id, @plan = idPlan FROM @Afiliados WHERE n = 1 + ABS(CHECKSUM(NEWID())) % @nAfil;
                SELECT @medico = nombre, @matricula = matricula FROM @Medicos WHERE n = 1 + ABS(CHECKSUM(NEWID())) % @nMed;
                SET @emision = DATEADD(DAY, -(ABS(CHECKSUM(NEWID())) % 6), @fecha);

                INSERT INTO Recetas (fechaEmision, fechaVencimiento, matriculaMedico, nombreMedico, estado, id_afiliado)
                VALUES (@emision, DATEADD(DAY, 30, @emision), @matricula, @medico, 1, @afiliado);
                SET @receta = SCOPE_IDENTITY();

                -- 1 a 3 medicamentos distintos según su popularidad
                INSERT INTO DetalleReceta (Cantidad, id_Receta, id_producto)
                SELECT TOP (1 + ABS(CHECKSUM(NEWID())) % 3) 1 + ABS(CHECKSUM(NEWID())) % 2, @receta, id
                FROM @Recetados
                ORDER BY -LOG(1 - RAND(CHECKSUM(NEWID())) * 0.999999) / peso;
            END

            INSERT INTO Venta (fecha, estado, tipoVenta, id_Receta, id_usuario)
            VALUES (@hora, CASE WHEN @anulada = 1 THEN 0 ELSE 1 END,
                    CASE WHEN @conReceta = 1 THEN 'Con receta' ELSE 'Venta libre' END,
                    @receta, @farma);
            SET @venta = SCOPE_IDENTITY();

            IF @conReceta = 1
                INSERT INTO DetalleVenta (cantidad, precioUnitario, descuento, id_producto, id_venta, id_cobertura)
                SELECT dr.Cantidad, p.precioVenta,
                       ROUND(dr.Cantidad * p.precioVenta * ISNULL(cp.porcentajeCobertura, 0) / 100, 2),
                       p.id_producto, @venta, cp.id_cobertura
                FROM DetalleReceta dr
                JOIN Producto p ON p.id_producto = dr.id_producto
                LEFT JOIN CoberturaPlan cp ON cp.idPlan = @plan AND cp.id_producto = dr.id_producto
                WHERE dr.id_Receta = @receta;

            -- Venta libre: 1 a 4 productos; con receta: 0 o 1 extra
            SET @extra = CASE WHEN @conReceta = 1 THEN ABS(CHECKSUM(NEWID())) % 2 ELSE 1 + ABS(CHECKSUM(NEWID())) % 4 END;
            INSERT INTO DetalleVenta (cantidad, precioUnitario, descuento, id_producto, id_venta, id_cobertura)
            SELECT TOP (@extra) CASE WHEN ABS(CHECKSUM(NEWID())) % 100 < 75 THEN 1 ELSE 2 + ABS(CHECKSUM(NEWID())) % 2 END,
                   precio, 0, id, @venta, NULL
            FROM @Libres
            ORDER BY -LOG(1 - RAND(CHECKSUM(NEWID())) * 0.999999) / peso;

            -- Cobro en la caja del turno correspondiente
            IF @anulada = 0
            BEGIN
                SET @cobro = DATEADD(MINUTE, 3 + ABS(CHECKSUM(NEWID())) % 30, @hora);
                SET @min = DATEDIFF(MINUTE, CAST(@fecha AS DATETIME), @cobro) - 480;
                SET @c = 1 + @min / @turno;
                IF @c > @nCajeros SET @c = @nCajeros;

                SELECT @caja = id_caja, @cajero = id_usuario FROM @CajasDia WHERE n = @c;
                SELECT @importe = SUM(cantidad * precioUnitario - descuento) FROM DetalleVenta WHERE id_venta = @venta;

                SET @r = ABS(CHECKSUM(NEWID())) % 100;
                SET @medio = CASE WHEN @r < 40 THEN 'Efectivo'
                                  WHEN @r < 68 THEN 'Débito'
                                  WHEN @r < 85 THEN 'Crédito'
                                  ELSE 'Transferencia' END;

                SET @vuelto = CASE WHEN @medio = 'Efectivo' THEN CEILING(@importe / 1000.0) * 1000 - @importe ELSE 0 END;

                INSERT INTO Cobro (fecha, metodo_pago, importe, id_venta, id_usuario, id_caja, monto_cambio, id_medio_pago)
                VALUES (@cobro, @medio, @importe, @venta, @cajero, @caja, @vuelto,
                        (SELECT id_medio_pago FROM MedioPago WHERE nombre = @medio));
                SET @cobroId = SCOPE_IDENTITY();

                -- Detalle del pago con tarjeta o transferencia
                IF @medio IN ('Débito', 'Crédito')
                    INSERT INTO DetallePagoTarjeta (id_facturacion, ultimos_4, titular, numero_autorizacion, cuotas)
                    VALUES (@cobroId, RIGHT('000' + CAST(ABS(CHECKSUM(NEWID())) % 10000 AS VARCHAR(4)), 4), 'Titular de prueba',
                            CAST(100000 + ABS(CHECKSUM(NEWID())) % 900000 AS VARCHAR(10)),
                            CASE WHEN @medio = 'Crédito' THEN 1 + (ABS(CHECKSUM(NEWID())) % 3) * 2 ELSE 1 END);  -- 1, 3 o 5 cuotas
                ELSE IF @medio = 'Transferencia'
                    INSERT INTO DetalleTransferencia (id_facturacion, numero_operacion)
                    VALUES (@cobroId, CAST(10000000 + ABS(CHECKSUM(NEWID())) % 90000000 AS VARCHAR(20)));
            END

            SET @v += 1;
        END

        -- 1.3 Alguna receta rechazada en el día (~1 de cada 3 días)
        IF @nAfil > 0 AND @nRecet > 0 AND ABS(CHECKSUM(NEWID())) % 3 = 0
        BEGIN
            SELECT @afiliado = id FROM @Afiliados WHERE n = 1 + ABS(CHECKSUM(NEWID())) % @nAfil;
            SELECT @medico = nombre, @matricula = matricula FROM @Medicos WHERE n = 1 + ABS(CHECKSUM(NEWID())) % @nMed;

            INSERT INTO Recetas (fechaEmision, fechaVencimiento, matriculaMedico, nombreMedico, estado, id_afiliado)
            VALUES (@fecha, DATEADD(DAY, 30, @fecha), @matricula, @medico, 0, @afiliado);

            INSERT INTO DetalleReceta (Cantidad, id_Receta, id_producto)
            SELECT TOP 1 1, SCOPE_IDENTITY(), id FROM @Recetados ORDER BY NEWID();
        END

        -- 1.4 Cierre de cada turno: arqueo en efectivo, ~15 % con diferencia
        UPDATE cj
        SET fecha_cierre = DATEADD(MINUTE, 480 + d.n * @turno, CAST(@fecha AS DATETIME)),
            estado = 0,
            monto_final = cj.monto_inicial
                + ISNULL((SELECT SUM(f.importe) FROM Cobro f WHERE f.id_caja = cj.id_caja AND f.metodo_pago = 'Efectivo'), 0)
                + CASE WHEN ABS(CHECKSUM(NEWID())) % 100 < 15 THEN (ABS(CHECKSUM(NEWID())) % 5 - 2) * 500 ELSE 0 END
        FROM Caja cj
        JOIN @CajasDia d ON d.id_caja = cj.id_caja;

        SET @dia -= 1;
    END

    PRINT CONCAT('1. Actividad generada: últimos ', @Dias, ' días hasta ayer.');
END


/* =====================================================================
   2. RECETAS DE HOY: recetas para validar, para vender y para las alertas
   ===================================================================== */

DECLARE @Hoy3 TABLE (n INT IDENTITY(1,1), estado BIT NULL, emision DATE);
INSERT INTO @Hoy3 (estado, emision) VALUES
    (NULL, @hoy), (NULL, @hoy), (NULL, DATEADD(DAY, -1, @hoy)), (NULL, DATEADD(DAY, -2, @hoy)),  -- pendientes de validar
    (1, DATEADD(DAY, -3, @hoy)), (1, DATEADD(DAY, -5, @hoy)), (1, DATEADD(DAY, -8, @hoy)),         -- validadas y vigentes
    (1, DATEADD(DAY, -27, @hoy)), (1, DATEADD(DAY, -28, @hoy)),                                   -- por vencer (2-3 días)
    (1, DATEADD(DAY, -35, @hoy)), (NULL, DATEADD(DAY, -40, @hoy));                                -- vencidas

DECLARE @k INT = 1, @est BIT, @em DATE, @rec INT, @afi INT, @nAf INT = (SELECT COUNT(*) FROM Afiliados WHERE activo = 1);

IF @nAf > 0 AND EXISTS (SELECT 1 FROM Producto WHERE requiereReceta = 1 AND estado = 1 AND stockVenta > 2)
   AND NOT EXISTS (SELECT 1 FROM Recetas WHERE matriculaMedico = 'MP 24108' AND fechaEmision = @hoy)
BEGIN
    WHILE @k <= (SELECT COUNT(*) FROM @Hoy3)
    BEGIN
        SELECT @est = estado, @em = emision FROM @Hoy3 WHERE n = @k;
        SELECT TOP 1 @afi = id_afiliado FROM Afiliados WHERE activo = 1 ORDER BY NEWID();

        INSERT INTO Recetas (fechaEmision, fechaVencimiento, matriculaMedico, nombreMedico, estado, id_afiliado)
        VALUES (@em, DATEADD(DAY, 30, @em), 'MP 24108', 'Dra. Carla Ledesma', @est, @afi);
        SET @rec = SCOPE_IDENTITY();

        -- Medicamentos con stock suficiente, así se pueden vender desde la app
        INSERT INTO DetalleReceta (Cantidad, id_Receta, id_producto)
        SELECT TOP (1 + ABS(CHECKSUM(NEWID())) % 2) 1, @rec, id_producto
        FROM Producto WHERE requiereReceta = 1 AND estado = 1 AND stockVenta > 2
        ORDER BY NEWID();

        SET @k += 1;
    END
    PRINT '2. Recetas de hoy: 4 pendientes, 5 validadas vigentes (2 por vencer), 2 vencidas.';
END
ELSE
    PRINT '2. Las recetas de hoy ya estaban cargadas.';


/* =====================================================================
   3. MOVIMIENTO DE HOY: caja abierta, ventas cobradas y preventas
   ===================================================================== */

DECLARE @cajeroHoy INT = (SELECT TOP 1 u.id_usuario FROM Usuario u JOIN Rol r ON r.id_rol = u.id_rol
                          WHERE r.nombre = 'Cajero' AND u.estado = 1 ORDER BY u.id_usuario);
DECLARE @farmaHoy  INT = (SELECT TOP 1 u.id_usuario FROM Usuario u JOIN Rol r ON r.id_rol = u.id_rol
                          WHERE r.nombre = 'Farmaceutico' AND u.estado = 1 ORDER BY u.id_usuario);
DECLARE @cajaHoy INT, @ventaHoy INT, @i INT = 1, @fechaHoy DATETIME, @medioHoy VARCHAR(30),
        @impHoy DECIMAL(10,2), @cobroHoy INT, @recHoy INT, @planHoy INT;

IF @cajeroHoy IS NOT NULL AND @farmaHoy IS NOT NULL
   AND NOT EXISTS (SELECT 1 FROM Venta WHERE fecha >= @hoy)
BEGIN
    -- 3.1 Caja abierta (si el cajero no tiene una)
    SELECT TOP 1 @cajaHoy = id_caja FROM Caja WHERE id_usuario = @cajeroHoy AND estado = 1;
    IF @cajaHoy IS NULL
    BEGIN
        INSERT INTO Caja (fecha_apertura, monto_inicial, estado, id_usuario)
        VALUES (DATEADD(HOUR, 8, CAST(@hoy AS DATETIME)), 20000, 1, @cajeroHoy);
        SET @cajaHoy = SCOPE_IDENTITY();
    END

    -- 3.2 Seis ventas libres: las 4 primeras cobradas, las 2 últimas pendientes
    WHILE @i <= 6
    BEGIN
        SET @fechaHoy = DATEADD(MINUTE, 510 + @i * 20, CAST(@hoy AS DATETIME));   -- desde las 08:50

        INSERT INTO Venta (fecha, estado, tipoVenta, id_Receta, id_usuario)
        VALUES (@fechaHoy, 1, 'Venta libre', NULL, @farmaHoy);
        SET @ventaHoy = SCOPE_IDENTITY();

        INSERT INTO DetalleVenta (cantidad, precioUnitario, descuento, id_producto, id_venta, id_cobertura)
        SELECT TOP (1 + ABS(CHECKSUM(NEWID())) % 3) 1, precioVenta, 0, id_producto, @ventaHoy, NULL
        FROM Producto WHERE estado = 1 AND requiereReceta = 0 AND stockVenta > 5
        ORDER BY NEWID();

        -- Igual que la app: el stock se descuenta al enviar la venta a caja
        UPDATE p SET stockVenta = p.stockVenta - d.cantidad
        FROM Producto p JOIN DetalleVenta d ON d.id_producto = p.id_producto
        WHERE d.id_venta = @ventaHoy;

        IF @i <= 4
        BEGIN
            SET @medioHoy = CHOOSE(@i, 'Efectivo', 'Débito', 'Transferencia', 'Crédito');
            SELECT @impHoy = SUM(cantidad * precioUnitario - descuento) FROM DetalleVenta WHERE id_venta = @ventaHoy;

            INSERT INTO Cobro (fecha, metodo_pago, importe, id_venta, id_usuario, id_caja, monto_cambio, id_medio_pago)
            VALUES (DATEADD(MINUTE, 6, @fechaHoy), @medioHoy, @impHoy, @ventaHoy, @cajeroHoy, @cajaHoy,
                    CASE WHEN @medioHoy = 'Efectivo' THEN CEILING(@impHoy / 1000.0) * 1000 - @impHoy ELSE 0 END,
                    (SELECT id_medio_pago FROM MedioPago WHERE nombre = @medioHoy));
            SET @cobroHoy = SCOPE_IDENTITY();

            IF @medioHoy IN ('Débito', 'Crédito')
                INSERT INTO DetallePagoTarjeta (id_facturacion, ultimos_4, titular, numero_autorizacion, cuotas)
                VALUES (@cobroHoy, '4521', 'Cliente de prueba', CAST(200000 + @i AS VARCHAR(10)),
                        CASE WHEN @medioHoy = 'Crédito' THEN 3 ELSE 1 END);
            ELSE IF @medioHoy = 'Transferencia'
                INSERT INTO DetalleTransferencia (id_facturacion, numero_operacion)
                VALUES (@cobroHoy, CAST(55000000 + @i AS VARCHAR(20)));
        END

        SET @i += 1;
    END

    -- 3.3 Una preventa con receta (usa una receta validada y vigente de las de hoy)
    SELECT TOP 1 @recHoy = r.id_Receta, @planHoy = a.idPlan
    FROM Recetas r JOIN Afiliados a ON a.id_afiliado = r.id_afiliado
    WHERE r.matriculaMedico = 'MP 24108' AND r.estado = 1 AND r.fechaVencimiento >= @hoy
      AND NOT EXISTS (SELECT 1 FROM Venta v WHERE v.id_Receta = r.id_Receta AND v.estado = 1)
      AND NOT EXISTS (SELECT 1 FROM DetalleReceta dr JOIN Producto p ON p.id_producto = dr.id_producto
                      WHERE dr.id_Receta = r.id_Receta AND p.stockVenta < dr.Cantidad)
    ORDER BY r.fechaEmision;

    IF @recHoy IS NOT NULL
    BEGIN
        INSERT INTO Venta (fecha, estado, tipoVenta, id_Receta, id_usuario)
        VALUES (DATEADD(MINUTE, 660, CAST(@hoy AS DATETIME)), 1, 'Con receta', @recHoy, @farmaHoy);
        SET @ventaHoy = SCOPE_IDENTITY();

        INSERT INTO DetalleVenta (cantidad, precioUnitario, descuento, id_producto, id_venta, id_cobertura)
        SELECT dr.Cantidad, p.precioVenta,
               ROUND(dr.Cantidad * p.precioVenta * ISNULL(cp.porcentajeCobertura, 0) / 100, 2),
               p.id_producto, @ventaHoy, cp.id_cobertura
        FROM DetalleReceta dr
        JOIN Producto p ON p.id_producto = dr.id_producto
        LEFT JOIN CoberturaPlan cp ON cp.idPlan = @planHoy AND cp.id_producto = dr.id_producto
        WHERE dr.id_Receta = @recHoy;

        UPDATE p SET stockVenta = p.stockVenta - d.cantidad
        FROM Producto p JOIN DetalleVenta d ON d.id_producto = p.id_producto
        WHERE d.id_venta = @ventaHoy;
    END

    PRINT '3. Movimiento de hoy: caja abierta, 4 ventas cobradas y 3 preventas pendientes de cobro.';
END
ELSE
    PRINT '3. El movimiento de hoy ya estaba cargado (o faltan cajero/farmacéutico activos).';

COMMIT TRANSACTION;

-- ---------- Resumen ----------
SELECT
    (SELECT COUNT(*) FROM Usuario)        AS usuarios,
    (SELECT COUNT(*) FROM Producto)       AS productos,
    (SELECT COUNT(*) FROM ObraSocial)     AS obras_sociales,
    (SELECT COUNT(*) FROM Planes)         AS planes,
    (SELECT COUNT(*) FROM Afiliados)      AS afiliados,
    (SELECT COUNT(*) FROM Venta)          AS ventas,
    (SELECT COUNT(*) FROM Venta WHERE estado = 0) AS anuladas,
    (SELECT COUNT(*) FROM Cobro)          AS cobros,
    (SELECT COUNT(*) FROM Caja)           AS cajas,
    (SELECT COUNT(*) FROM Recetas)        AS recetas;

END TRY
BEGIN CATCH
    IF @@TRANCOUNT > 0
        ROLLBACK TRANSACTION;

    PRINT 'No se cargó nada (se deshizo todo): ' + ERROR_MESSAGE();
END CATCH;
GO
