-- 1.5 Planes por perfil de afiliado, con su porcentaje base de cobertura
DECLARE @Planes TABLE (codigo VARCHAR(20), plan_ VARCHAR(100), descripcion VARCHAR(200), pct DECIMAL(5,2));
INSERT INTO @Planes VALUES
    ('IOSCOR', 'Activos',     'Afiliados en actividad',          40),
