       (SELECT TOP 1 u.contrasena FROM Usuario u WHERE u.id_rol = r.id_rol ORDER BY u.id_usuario),
       1, 0, r.id_rol
FROM (VALUES
    ('30111222', 'Lucía',   'Fernández', 'lfernandez@farmagest.com', 'Farmaceutico'),
    ('31222333', 'Martín',  'Ríos',      'mrios@farmagest.com',      'Farmaceutico'),
    ('32333444', 'Sofía',   'Benítez',   'sbenitez@farmagest.com',   'Cajero')
) AS n (dni, nombre, apellido, email, rol)
JOIN Rol r ON r.nombre = n.rol
WHERE NOT EXISTS (SELECT 1 FROM Usuario u WHERE u.dni = n.dni)
  AND EXISTS (SELECT 1 FROM Usuario u WHERE u.id_rol = r.id_rol);

