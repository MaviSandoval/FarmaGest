INSERT INTO Planes (nombrePlan, descripcion, id_ObraSocial)
SELECT p.plan_, p.descripcion, o.id_ObraSocial
FROM @Planes p
JOIN ObraSocial o ON o.codigo = p.codigo
WHERE NOT EXISTS (SELECT 1 FROM Planes x WHERE x.nombrePlan = p.plan_ AND x.id_ObraSocial = o.id_ObraSocial);

-- 1.6 Cobertura de cada plan sobre cada medicamento
--     Los de venta libre se cubren 10 puntos menos que los recetados.
INSERT INTO CoberturaPlan (porcentajeCobertura, idPlan, id_producto)
SELECT CASE WHEN pr.requiereReceta = 1 THEN p.pct ELSE p.pct - 10 END,
       pl.idPlan, pr.id_producto
FROM @Planes p
JOIN ObraSocial o ON o.codigo = p.codigo
JOIN Planes pl    ON pl.id_ObraSocial = o.id_ObraSocial AND pl.nombrePlan = p.plan_
CROSS JOIN Producto pr
WHERE pr.esMedicamento = 1 AND pr.estado = 1
  AND NOT EXISTS (SELECT 1 FROM CoberturaPlan x WHERE x.idPlan = pl.idPlan AND x.id_producto = pr.id_producto);

-- 1.7 Afiliados (60 combinaciones de nombre y apellido que todavía no existan)
DECLARE @Nombres TABLE (nombre VARCHAR(80));
