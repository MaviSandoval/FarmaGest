/* =====================================================================
   FARMAGEST - SCRIPT DE ACTUALIZACIÓN
   ---------------------------------------------------------------------
   Taller de Programación II - FaCENA UNNE - 2026 - Grupo 23
   Motor: SQL Server

   Para bases FarmaGestDB que ya estaban creadas antes de estos cambios.
   Se puede ejecutar más de una vez: cada paso verifica si ya está aplicado.
   (Las bases nuevas no lo necesitan: el script de creación ya lo incluye.)

   Contenido:
     0. Facturacion pasa a llamarse Cobro (pedido del profesor; no se pierden datos)
     1. Cobro.monto_cambio ............. vuelto entregado en cobros en efectivo
     2. CK_Producto_StockVenta ......... el stock nunca puede quedar negativo
     3. Recetas.estado acepta NULL ..... NULL = Pendiente de validación
     4. Tabla Configuracion ............ parámetros (backup automático on/off)
     5. UX_Venta_RecetaActiva .......... una receta, una sola venta activa
     6. Medios de pago ................. MedioPago, Cobro.id_medio_pago,
                                         DetallePagoTarjeta, DetalleTransferencia
   ===================================================================== */

USE FarmaGestDB;
GO


/* =====================================================================
   0. RENOMBRAR Facturacion -> Cobro
      sp_rename cambia el nombre conservando datos, claves y relaciones.
      También se renombran las restricciones para que coincidan.
   ===================================================================== */

IF OBJECT_ID('dbo.Facturacion') IS NOT NULL AND OBJECT_ID('dbo.Cobro') IS NULL
BEGIN
    EXEC sp_rename 'Facturacion', 'Cobro';

    IF OBJECT_ID('UQ_Facturacion_Venta') IS NOT NULL       EXEC sp_rename 'UQ_Facturacion_Venta', 'UQ_Cobro_Venta', 'OBJECT';
    IF OBJECT_ID('FK_Facturacion_Venta') IS NOT NULL       EXEC sp_rename 'FK_Facturacion_Venta', 'FK_Cobro_Venta', 'OBJECT';
    IF OBJECT_ID('FK_Facturacion_Usuario') IS NOT NULL     EXEC sp_rename 'FK_Facturacion_Usuario', 'FK_Cobro_Usuario', 'OBJECT';
    IF OBJECT_ID('FK_Facturacion_Caja') IS NOT NULL        EXEC sp_rename 'FK_Facturacion_Caja', 'FK_Cobro_Caja', 'OBJECT';
    IF OBJECT_ID('DF_Facturacion_MontoCambio') IS NOT NULL EXEC sp_rename 'DF_Facturacion_MontoCambio', 'DF_Cobro_MontoCambio', 'OBJECT';
    IF OBJECT_ID('FK_Facturacion_MedioPago') IS NOT NULL   EXEC sp_rename 'FK_Facturacion_MedioPago', 'FK_Cobro_MedioPago', 'OBJECT';

    PRINT 'La tabla Facturacion ahora se llama Cobro.';
END
ELSE
    PRINT 'La tabla Cobro ya existía.';
GO


/* =====================================================================
   1. COBRO: columna monto_cambio (vuelto en cobros en efectivo)
      El código la mapea como monto_cambio. Si la base tiene la versión
      anterior "MontoCambio" se renombra; si no existe, se crea.
   ===================================================================== */

IF COL_LENGTH('Cobro', 'monto_cambio') IS NULL AND COL_LENGTH('Cobro', 'MontoCambio') IS NOT NULL
BEGIN
    EXEC sp_rename 'Cobro.MontoCambio', 'monto_cambio', 'COLUMN';
    PRINT 'Cobro.MontoCambio ahora se llama monto_cambio.';
END
ELSE IF COL_LENGTH('Cobro', 'monto_cambio') IS NULL
BEGIN
    ALTER TABLE Cobro
        ADD monto_cambio DECIMAL(18,2) NOT NULL
            CONSTRAINT DF_Cobro_MontoCambio DEFAULT 0;
    PRINT 'Agregada la columna Cobro.monto_cambio.';
END
ELSE
    PRINT 'Cobro.monto_cambio ya existía.';
GO


/* =====================================================================
   2. PRODUCTO: stock no negativo
      La venta descuenta el stock con un UPDATE condicional atómico
      (VentaService). Esta restricción es la red de seguridad de la base:
      ningún camino puede dejar stockVenta por debajo de cero.
   ===================================================================== */

IF NOT EXISTS (SELECT 1 FROM sys.check_constraints WHERE name = 'CK_Producto_StockVenta')
BEGIN
    -- Si quedó algún stock negativo de pruebas anteriores, se corrige antes
    UPDATE Producto SET stockVenta = 0 WHERE stockVenta < 0;

    ALTER TABLE Producto
        ADD CONSTRAINT CK_Producto_StockVenta CHECK (stockVenta >= 0);

    PRINT 'Agregada la restricción CK_Producto_StockVenta.';
END
ELSE
    PRINT 'CK_Producto_StockVenta ya existía.';
GO


/* =====================================================================
   3. RECETAS: estado acepta NULL
      NULL = Pendiente (todavía no la revisó el Farmacéutico),
      1 = Validada, 0 = Rechazada. Antes la columna era NOT NULL DEFAULT 1,
      así que toda receta entraba validada sin pasar por el Farmacéutico.
   ===================================================================== */

IF EXISTS (SELECT 1 FROM sys.columns
           WHERE object_id = OBJECT_ID('Recetas') AND name = 'estado' AND is_nullable = 0)
BEGIN
    -- Se quita el DEFAULT 1 (su nombre lo genera SQL Server, por eso se busca)
    DECLARE @default SYSNAME =
        (SELECT d.name
         FROM sys.default_constraints d
         JOIN sys.columns c ON c.object_id = d.parent_object_id AND c.column_id = d.parent_column_id
         WHERE c.object_id = OBJECT_ID('Recetas') AND c.name = 'estado');

    IF @default IS NOT NULL
        EXEC('ALTER TABLE Recetas DROP CONSTRAINT ' + @default);

    ALTER TABLE Recetas ALTER COLUMN estado BIT NULL;

    PRINT 'Recetas.estado ahora acepta NULL (Pendiente).';
END
ELSE
    PRINT 'Recetas.estado ya aceptaba NULL.';
GO


/* =====================================================================
   4. CONFIGURACION: parámetros del sistema (clave / valor)
      BackupAutomaticoActivo: '1' = backup diario a las 00:00, '0' = solo manual.
      Se cambia desde Administrador > Configuración.
   ===================================================================== */

IF OBJECT_ID('dbo.Configuracion') IS NULL
BEGIN
    CREATE TABLE Configuracion (
        clave  VARCHAR(50)  NOT NULL PRIMARY KEY,
        valor  VARCHAR(200) NOT NULL
    );

    PRINT 'Creada la tabla Configuracion.';
END
ELSE
    PRINT 'La tabla Configuracion ya existía.';
GO

IF NOT EXISTS (SELECT 1 FROM Configuracion WHERE clave = 'BackupAutomaticoActivo')
    INSERT INTO Configuracion (clave, valor) VALUES ('BackupAutomaticoActivo', '1');
GO


/* =====================================================================
   5. VENTA: una receta en una sola venta activa
      Si dos farmacéuticos arman una venta con la misma receta al mismo
      tiempo, la base deja guardar solo la primera (VentaService avisa a la otra).
   ===================================================================== */

IF NOT EXISTS (SELECT 1 FROM sys.indexes WHERE name = 'UX_Venta_RecetaActiva')
BEGIN
    IF EXISTS (SELECT id_Receta FROM Venta
               WHERE estado = 1 AND id_Receta IS NOT NULL
               GROUP BY id_Receta HAVING COUNT(*) > 1)
        PRINT 'ATENCIÓN: hay recetas usadas en más de una venta activa. Anulá las ventas repetidas y volvé a ejecutar este paso.';
    ELSE
    BEGIN
        CREATE UNIQUE INDEX UX_Venta_RecetaActiva ON Venta (id_Receta)
            WHERE estado = 1 AND id_Receta IS NOT NULL;

        PRINT 'Creado el índice UX_Venta_RecetaActiva.';
    END
END
ELSE
    PRINT 'UX_Venta_RecetaActiva ya existía.';
GO


/* =====================================================================
   6. MEDIOS DE PAGO
      Cada cobro se relaciona con un medio de pago. Los datos propios de
      la tarjeta y de la transferencia van en tablas de detalle.
      metodo_pago se mantiene por compatibilidad con el código anterior.
   ===================================================================== */

IF OBJECT_ID('dbo.MedioPago') IS NULL
BEGIN
    CREATE TABLE MedioPago (
        id_medio_pago  INT IDENTITY(1,1) PRIMARY KEY,
        nombre         VARCHAR(30) NOT NULL,
        estado         BIT         NOT NULL DEFAULT 1,

        CONSTRAINT UQ_MedioPago_Nombre UNIQUE (nombre)
    );
    PRINT 'Creada la tabla MedioPago.';
END
ELSE
    PRINT 'La tabla MedioPago ya existía.';
GO

-- Medios que usa el código (compara por nombre)
INSERT INTO MedioPago (nombre)
SELECT m.nombre
FROM (VALUES ('Efectivo'), ('Débito'), ('Crédito'), ('Transferencia')) AS m (nombre)
WHERE NOT EXISTS (SELECT 1 FROM MedioPago x WHERE x.nombre = m.nombre);
GO

IF COL_LENGTH('Cobro', 'id_medio_pago') IS NULL
BEGIN
    ALTER TABLE Cobro ADD id_medio_pago INT NULL;
    PRINT 'Agregada la columna Cobro.id_medio_pago.';
END
ELSE
    PRINT 'Cobro.id_medio_pago ya existía.';
GO

-- Cobros anteriores: se les asigna el medio según el texto de metodo_pago
-- (si hubiera un nombre que no está en MedioPago, se agrega como inactivo)
INSERT INTO MedioPago (nombre, estado)
SELECT DISTINCT c.metodo_pago, 0
FROM Cobro c
WHERE c.id_medio_pago IS NULL
  AND NOT EXISTS (SELECT 1 FROM MedioPago m WHERE m.nombre = c.metodo_pago);

UPDATE c
SET id_medio_pago = m.id_medio_pago
FROM Cobro c
JOIN MedioPago m ON m.nombre = c.metodo_pago
WHERE c.id_medio_pago IS NULL;
GO

IF EXISTS (SELECT 1 FROM sys.columns
           WHERE object_id = OBJECT_ID('Cobro') AND name = 'id_medio_pago' AND is_nullable = 1)
BEGIN
    ALTER TABLE Cobro ALTER COLUMN id_medio_pago INT NOT NULL;
    PRINT 'Cobro.id_medio_pago ahora es obligatorio.';
END
GO

IF NOT EXISTS (SELECT 1 FROM sys.foreign_keys
               WHERE parent_object_id = OBJECT_ID('Cobro') AND referenced_object_id = OBJECT_ID('MedioPago'))
BEGIN
    ALTER TABLE Cobro
        ADD CONSTRAINT FK_Cobro_MedioPago FOREIGN KEY (id_medio_pago) REFERENCES MedioPago(id_medio_pago);
    PRINT 'Agregada la clave foránea FK_Cobro_MedioPago.';
END
ELSE
    PRINT 'FK_Cobro_MedioPago ya existía.';
GO

IF OBJECT_ID('dbo.DetallePagoTarjeta') IS NULL
BEGIN
    CREATE TABLE DetallePagoTarjeta (
        id_detalle_pago      INT IDENTITY(1,1) PRIMARY KEY,
        id_facturacion       INT          NOT NULL,
        ultimos_4            VARCHAR(4)   NOT NULL,
        titular              VARCHAR(100) NOT NULL,
        numero_autorizacion  VARCHAR(50)  NOT NULL,
        cuotas               INT          NOT NULL DEFAULT 1,

        CONSTRAINT UQ_DetallePagoTarjeta_Cobro UNIQUE (id_facturacion),
        CONSTRAINT FK_DetallePagoTarjeta_Cobro FOREIGN KEY (id_facturacion) REFERENCES Cobro(id_facturacion)
    );
    PRINT 'Creada la tabla DetallePagoTarjeta.';
END
ELSE
    PRINT 'La tabla DetallePagoTarjeta ya existía.';
GO

IF OBJECT_ID('dbo.DetalleTransferencia') IS NULL
BEGIN
    CREATE TABLE DetalleTransferencia (
        id_detalle_transferencia  INT IDENTITY(1,1) PRIMARY KEY,
        id_facturacion            INT          NOT NULL,
        numero_operacion          VARCHAR(100) NOT NULL,

        CONSTRAINT UQ_DetalleTransferencia_Cobro UNIQUE (id_facturacion),
        CONSTRAINT FK_DetalleTransferencia_Cobro FOREIGN KEY (id_facturacion) REFERENCES Cobro(id_facturacion)
    );
    PRINT 'Creada la tabla DetalleTransferencia.';
END
ELSE
    PRINT 'La tabla DetalleTransferencia ya existía.';
GO
