<Application x:Class="FarmaGest.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Paleta de la marca FarmaGest -->
            <SolidColorBrush x:Key="FarmaPrimaryBrush" Color="#1F7A6C" />
            <SolidColorBrush x:Key="FarmaAccentBrush" Color="#2FA98C" />
            <SolidColorBrush x:Key="FarmaSidebarBrush" Color="#123B3A" />
            <SolidColorBrush x:Key="FarmaBackgroundBrush" Color="#F4F7F6" />
            <SolidColorBrush x:Key="FarmaCardBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="FarmaTextMutedBrush" Color="#6B7B79" />
            <SolidColorBrush x:Key="FarmaDangerBrush" Color="#D64550" />
            <SolidColorBrush x:Key="FarmaWarningBrush" Color="#E0A93B" />
            <SolidColorBrush x:Key="FarmaSuccessBrush" Color="#2FA98C" />

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource FarmaCardBrush}" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="18" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="1" Opacity="0.08" Color="#000000" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SidebarNavItem" TargetType="RadioButton">
                <Setter Property="GroupName" Value="SidebarNav" />
                <Setter Property="Foreground" Value="#C9DEDA" />
                <Setter Property="Height" Value="42" />
                <Setter Property="Margin" Value="10,2" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bg" CornerRadius="6" Padding="14,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                                   FontSize="17" Foreground="{TemplateBinding Foreground}" />
                                    <TextBlock Text="{TemplateBinding Content}" Margin="12,0,0,0"
                                               FontSize="13.5" Foreground="{TemplateBinding Foreground}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource FarmaAccentBrush}" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#1B554F" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
