<Page x:Class="FarmaGest.UI.Views.Administrador.ConfiguracionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:h="clr-namespace:FarmaGest.UI.Helpers"
      Title="Configuración">

	<!-- MAQUETA: configuración general y copia de seguridad -->

	<Page.Resources>
		<ResourceDictionary Source="/FarmaGest.UI;component/Views/Farmaceutico/EstilosFarmaceutico.xaml" />
	</Page.Resources>

	<ScrollViewer VerticalScrollBarVisibility="Auto">
		<Grid Margin="26,20">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<!-- ===================== ENCABEZADO ===================== -->
			<StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,16">
				<TextBlock Text="Configuración" Style="{StaticResource PageTitleText}" />
				<TextBlock Text="Datos de la farmacia, parámetros del sistema y copias de seguridad de la base de datos."
                           Style="{StaticResource PageSubtitleText}" />
			</StackPanel>

			<!-- ===================== DATOS DE LA FARMACIA ===================== -->
			<Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,16">
				<StackPanel>
					<StackPanel Orientation="Horizontal" Margin="0,0,0,12">
						<ui:SymbolIcon Symbol="Building24" FontSize="18" Foreground="{StaticResource FarmaPrimaryBrush}" />
						<TextBlock Text="Datos de la farmacia" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
					</StackPanel>

					<TextBlock Text="Nombre" Style="{StaticResource FieldLabelText}" />
					<ui:TextBox Text="Farma Gest" MaxLength="100" Margin="0,0,0,12" />

					<UniformGrid Columns="2">
						<StackPanel Margin="0,0,8,12">
							<TextBlock Text="CUIT (solo números)" Style="{StaticResource FieldLabelText}" />
							<ui:TextBox PlaceholderText="Ej.: 30123456789" h:ValidacionEntrada.Tipo="Entero" MaxLength="11" />
						</StackPanel>
						<StackPanel Margin="8,0,0,12">
							<TextBlock Text="Teléfono (solo números)" Style="{StaticResource FieldLabelText}" />
							<ui:TextBox PlaceholderText="Ej.: 3794000000" h:ValidacionEntrada.Tipo="Entero" MaxLength="15" />
						</StackPanel>
					</UniformGrid>

					<TextBlock Text="Dirección" Style="{StaticResource FieldLabelText}" />
					<ui:TextBox Text="Av. Ejemplo 1234, Corrientes" MaxLength="150" Margin="0,0,0,12"
                                h:ValidacionEntrada.Tipo="Alfanumerico" />

					<ui:Button Content="Guardar datos" Appearance="Primary" Icon="{ui:SymbolIcon Save24}"
                               HorizontalAlignment="Left" Click="Guardar_Click" />
				</StackPanel>
			</Border>

			<!-- ===================== PARÁMETROS ===================== -->
			<Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,16">
				<StackPanel>
					<StackPanel Orientation="Horizontal" Margin="0,0,0,12">
						<ui:SymbolIcon Symbol="Settings24" FontSize="18" Foreground="{StaticResource FarmaPrimaryBrush}" />
						<TextBlock Text="Parámetros del sistema" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
					</StackPanel>

					<UniformGrid Columns="2">
						<StackPanel Margin="0,0,8,12">
							<TextBlock Text="Stock mínimo por defecto" Style="{StaticResource FieldLabelText}" />
							<ui:TextBox Text="10" h:ValidacionEntrada.Tipo="Entero" MaxLength="4" />
						</StackPanel>
						<StackPanel Margin="8,0,0,12">
							<TextBlock Text="Vigencia de recetas (días)" Style="{StaticResource FieldLabelText}" />
							<ui:TextBox Text="30" h:ValidacionEntrada.Tipo="Entero" MaxLength="3" />
						</StackPanel>
						<StackPanel Margin="0,0,8,12">
							<TextBlock Text="Intentos de login antes de bloquear" Style="{StaticResource FieldLabelText}" />
							<ui:TextBox Text="3" h:ValidacionEntrada.Tipo="Entero" MaxLength="2" />
						</StackPanel>
						<StackPanel Margin="8,0,0,12">
							<TextBlock Text="Monto inicial sugerido de caja ($)" Style="{StaticResource FieldLabelText}" />
							<ui:TextBox Text="20000" h:ValidacionEntrada.Tipo="Decimal" MaxLength="12" />
						</StackPanel>
					</UniformGrid>

					<CheckBox Content="Pedir cambio de contraseña a los usuarios nuevos" IsChecked="True" Margin="0,0,0,12" />

					<ui:Button Content="Guardar parámetros" Appearance="Primary" Icon="{ui:SymbolIcon Save24}"
                               HorizontalAlignment="Left" Click="Guardar_Click" />
				</StackPanel>
			</Border>

			<!-- ===================== COPIA DE SEGURIDAD ===================== -->
			<Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}">
				<StackPanel>
					<StackPanel Orientation="Horizontal" Margin="0,0,0,12">
						<ui:SymbolIcon Symbol="Database24" FontSize="18" Foreground="{StaticResource FarmaPrimaryBrush}" />
						<TextBlock Text="Copia de seguridad de la base de datos" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
					</StackPanel>

					<Grid Margin="0,0,0,14">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<StackPanel Grid.Column="0" Margin="0,0,12,0">
							<TextBlock Text="Carpeta de destino" Style="{StaticResource FieldLabelText}" />
							<ui:TextBox x:Name="CarpetaBackupText" Text="C:\FarmaGest\Backups" IsReadOnly="True" />
						</StackPanel>
						<ui:Button Grid.Column="1" Content="Elegir carpeta..." VerticalAlignment="Bottom"
                                   Icon="{ui:SymbolIcon Folder24}" Click="ElegirCarpeta_Click" />
					</Grid>

					<StackPanel Orientation="Horizontal" Margin="0,0,0,14">
						<ui:Button Content="Generar copia ahora" Appearance="Primary" Icon="{ui:SymbolIcon ArrowDownload24}"
                                   Margin="0,0,8,0" Click="GenerarBackup_Click" />
						<ui:Button Content="Restaurar copia..." Appearance="Secondary" Icon="{ui:SymbolIcon ArrowUpload24}"
                                   Click="RestaurarBackup_Click" />
					</StackPanel>

					<TextBlock Text="Últimas copias" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
					<DataGrid x:Name="BackupsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="36"
                              Background="Transparent" BorderThickness="0" MaxHeight="190">
						<DataGrid.Columns>
							<DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="*" />
							<DataGridTextColumn Header="Archivo" Binding="{Binding Archivo}" Width="2*" />
							<DataGridTextColumn Header="Tamaño" Binding="{Binding Tamano}" Width="*" />
							<DataGridTextColumn Header="Generada por" Binding="{Binding Usuario}" Width="*" />
						</DataGrid.Columns>
					</DataGrid>
				</StackPanel>
			</Border>
		</Grid>
	</ScrollViewer>
</Page>
