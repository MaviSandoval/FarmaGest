<Page x:Class="FarmaGest.UI.Views.Administrador.ConfiguracionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Configuración">
	<Grid Margin="26,20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<TextBlock Grid.Row="0" Text="Configuración" FontSize="20" FontWeight="Bold" Margin="0,0,0,16" />

		<Border Grid.Row="1" Style="{StaticResource CardStyle}">
			<StackPanel MaxWidth="420">
				<TextBlock Text="Nombre de la farmacia" FontSize="11" Foreground="{StaticResource FarmaTextMutedBrush}" Margin="0,0,0,4" />
				<TextBox Text="Farma Gest" Margin="0,0,0,16" />

				<TextBlock Text="Umbral de stock bajo" FontSize="11" Foreground="{StaticResource FarmaTextMutedBrush}" Margin="0,0,0,4" />
				<TextBox Text="10" Margin="0,0,0,16" />

				<ui:Button Content="Guardar" Appearance="Primary" />
			</StackPanel>
		</Border>
	</Grid>
</Page>