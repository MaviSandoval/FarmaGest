<Page x:Class="FarmaGest.UI.Views.Administrador.GestionUsuariosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:h="clr-namespace:FarmaGest.UI.Helpers"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Usuarios">

	<Page.Resources>
		<ResourceDictionary Source="/FarmaGest.UI;component/Views/Farmaceutico/EstilosFarmaceutico.xaml" />
	</Page.Resources>

	<Grid Margin="26,20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!-- ===================== ENCABEZADO ===================== -->
		<StackPanel Grid.Row="0" Margin="0,0,0,16">
			<TextBlock Text="Gestión de usuarios" Style="{StaticResource PageTitleText}" />
			<TextBlock Text="Alta, edición y baja de los usuarios que ingresan al sistema. Todos los cambios usan los procedimientos almacenados."
                       Style="{StaticResource PageSubtitleText}" />
		</StackPanel>

		<!-- ===================== FORMULARIO ALTA / EDICIÓN ===================== -->
		<Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
			<StackPanel>
				<StackPanel Orientation="Horizontal" Margin="0,0,0,12">
					<ui:SymbolIcon Symbol="PersonAdd24" FontSize="18" Foreground="{StaticResource FarmaPrimaryBrush}" />
					<TextBlock x:Name="TituloFormularioText" Text="Nuevo usuario" FontWeight="SemiBold"
                               FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center" />
				</StackPanel>

				<UniformGrid Columns="5" Rows="1">
					<StackPanel Margin="0,0,10,0">
						<TextBlock Text="DNI" Style="{StaticResource FieldLabelText}" />
						<TextBox x:Name="DniText" h:ValidacionEntrada.Tipo="Entero" MaxLength="8" ToolTip="Solo números, 7 u 8 dígitos" />
					</StackPanel>
					<StackPanel Margin="0,0,10,0">
						<TextBlock Text="Nombre" Style="{StaticResource FieldLabelText}" />
						<TextBox x:Name="NombreText" h:ValidacionEntrada.Tipo="SoloLetras" MaxLength="80" />
					</StackPanel>
					<StackPanel Margin="0,0,10,0">
						<TextBlock Text="Apellido" Style="{StaticResource FieldLabelText}" />
						<TextBox x:Name="ApellidoText" h:ValidacionEntrada.Tipo="SoloLetras" MaxLength="80" />
					</StackPanel>
					<StackPanel Margin="0,0,10,0">
						<TextBlock Text="Email" Style="{StaticResource FieldLabelText}" />
						<TextBox x:Name="EmailText" h:ValidacionEntrada.Tipo="Email" MaxLength="120" />
					</StackPanel>
					<StackPanel>
						<TextBlock Text="Rol" Style="{StaticResource FieldLabelText}" />
						<ComboBox x:Name="RolCombo" DisplayMemberPath="Nombre" SelectedValuePath="Id" />
					</StackPanel>
				</UniformGrid>

				<Grid Margin="0,14,0,0">
					<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
						<ui:SymbolIcon Symbol="Info24" FontSize="15" Foreground="{StaticResource FarmaTextMutedBrush}" />
						<TextBlock Text="Al crear el usuario se genera una contraseña temporal que deberá cambiar en su primer ingreso."
                                   FontSize="11.5" Foreground="{StaticResource FarmaTextMutedBrush}" Margin="6,0,0,0" />
					</StackPanel>
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
						<TextBlock x:Name="MensajeText" Foreground="{StaticResource FarmaDangerBrush}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap" MaxWidth="360" />
						<ui:Button x:Name="CancelarButton" Content="Cancelar" Margin="0,0,8,0"
                                   Click="CancelarButton_Click" Visibility="Collapsed" />
						<ui:Button x:Name="GuardarButton" Content="Guardar" Appearance="Primary"
                                   Icon="{ui:SymbolIcon Save24}" Click="GuardarButton_Click" />
					</StackPanel>
				</Grid>
			</StackPanel>
		</Border>

		<!-- ===================== LISTADO ===================== -->
		<Border Grid.Row="2" Style="{StaticResource CardStyle}">
			<DockPanel>
				<TextBlock DockPanel.Dock="Top" Text="Usuarios registrados" FontWeight="SemiBold" Margin="0,0,0,10" />
				<DataGrid x:Name="UsuariosGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          RowHeight="40"
                          Background="Transparent"
                          BorderThickness="0">
					<DataGrid.Columns>
						<DataGridTextColumn Header="DNI" Binding="{Binding Dni}" Width="*" />
						<DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="1.2*" />
						<DataGridTextColumn Header="Apellido" Binding="{Binding Apellido}" Width="1.2*" />
						<DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.6*" />
						<DataGridTemplateColumn Header="Rol" Width="1.1*">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Border Style="{StaticResource EtiquetaNeutra}">
										<TextBlock Text="{Binding Rol.Nombre}" />
									</Border>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
						<DataGridTemplateColumn Header="Estado" Width="100">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Border Style="{StaticResource EstadoTextoBadge}">
										<TextBlock Text="{Binding EstadoTexto}" />
									</Border>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
						<DataGridTemplateColumn Header="Acciones" Width="1.4*">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<StackPanel Orientation="Horizontal">
										<ui:HyperlinkButton Content="Editar" Padding="0" Margin="0,0,12,0"
                                                            Click="EditarUsuario_Click" Tag="{Binding}" />
										<ui:HyperlinkButton Content="{Binding TextoAccionEstado}" Padding="0"
                                                            Click="CambiarEstadoUsuario_Click" Tag="{Binding}" />
									</StackPanel>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
					</DataGrid.Columns>
				</DataGrid>
			</DockPanel>
		</Border>
	</Grid>
</Page>
