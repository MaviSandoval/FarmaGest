<Page x:Class="FarmaGest.UI.Views.Administrador.ProductosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Productos">

	<Grid Margin="26,20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<TextBlock Grid.Row="0" Text="Gestión de productos" FontSize="20" FontWeight="Bold" Margin="0,0,0,16" />

		<!-- Formulario alta / edición -->
		<Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
			<StackPanel>
				<TextBlock x:Name="TituloFormularioText" Text="Nuevo producto" FontWeight="SemiBold" Margin="0,0,0,10" />
				<UniformGrid Columns="5" Rows="1">
					<StackPanel Margin="0,0,8,0">
						<TextBlock Text="Descripción" FontSize="11" Foreground="{StaticResource FarmaTextMutedBrush}" Margin="0,0,0,4" />
						<TextBox x:Name="DescripcionText" />
					</StackPanel>
					<StackPanel Margin="0,0,8,0">
						<TextBlock Text="Categoría" FontSize="11" Foreground="{StaticResource FarmaTextMutedBrush}" Margin="0,0,0,4" />
						<ComboBox x:Name="CategoriaCombo" DisplayMemberPath="Nombre" />
					</StackPanel>
					<StackPanel Margin="0,0,8,0">
						<TextBlock Text="Precio" FontSize="11" Foreground="{StaticResource FarmaTextMutedBrush}" Margin="0,0,0,4" />
						<TextBox x:Name="PrecioText" />
					</StackPanel>
					<StackPanel Margin="0,0,8,0">
						<TextBlock Text="Stock" FontSize="11" Foreground="{StaticResource FarmaTextMutedBrush}" Margin="0,0,0,4" />
						<TextBox x:Name="StockText" />
					</StackPanel>
					<StackPanel VerticalAlignment="Bottom">
						<CheckBox x:Name="RequiereRecetaCheck" Content="Requiere receta" Margin="0,0,0,6" />
						<CheckBox x:Name="EsMedicamentoCheck" Content="Es medicamento" />
					</StackPanel>
				</UniformGrid>
				<StackPanel Orientation="Horizontal" Margin="0,12,0,0">
					<ui:Button x:Name="GuardarButton" Content="Guardar" Appearance="Primary" Click="GuardarButton_Click" />
					<ui:Button x:Name="CancelarButton" Content="Cancelar" Margin="8,0,0,0" Click="CancelarButton_Click" Visibility="Collapsed" />
					<TextBlock x:Name="MensajeText" Foreground="{StaticResource FarmaDangerBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
				</StackPanel>
			</StackPanel>
		</Border>

		<!-- Listado -->
		<Border Grid.Row="2" Style="{StaticResource CardStyle}">
			<DataGrid x:Name="ProductosGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      RowHeight="36"
                      Background="Transparent"
                      BorderThickness="0">
				<DataGrid.Columns>
					<DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="2*" />
					<DataGridTextColumn Header="Categoría" Binding="{Binding Categoria.Nombre}" Width="1.2*" />
					<DataGridTextColumn Header="Precio" Binding="{Binding PrecioVenta, StringFormat='$ {0:N2}'}" Width="*" />
					<DataGridTextColumn Header="Stock" Binding="{Binding StockVenta}" Width="*" />
					<DataGridTextColumn Header="Requiere receta" Binding="{Binding RequiereRecetaTexto}" Width="*" />
					<DataGridTextColumn Header="Estado" Binding="{Binding EstadoTexto}" Width="*" />
					<DataGridTemplateColumn Header="Acciones" Width="1.5*">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<StackPanel Orientation="Horizontal">
									<ui:HyperlinkButton Content="Editar" Padding="0" Margin="0,0,12,0"
                                                         Click="EditarProducto_Click" Tag="{Binding}" />
									<ui:HyperlinkButton Content="{Binding TextoAccionEstado}" Padding="0"
                                                         Click="CambiarEstadoProducto_Click" Tag="{Binding}" />
								</StackPanel>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
				</DataGrid.Columns>
			</DataGrid>
		</Border>
	</Grid>
</Page>