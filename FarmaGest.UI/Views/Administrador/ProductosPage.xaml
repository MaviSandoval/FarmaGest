<Page x:Class="FarmaGest.UI.Views.Administrador.ProductosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:h="clr-namespace:FarmaGest.UI.Helpers"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Productos">

	<Page.Resources>
		<ResourceDictionary Source="/FarmaGest.UI;component/Views/Farmaceutico/EstilosFarmaceutico.xaml" />
	</Page.Resources>

	<Grid Margin="26,20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!-- ===================== ENCABEZADO ===================== -->
		<StackPanel Grid.Row="0" Margin="0,0,0,16">
			<TextBlock Text="Gestión de productos" Style="{StaticResource PageTitleText}" />
			<TextBlock Text="Alta, edición y baja de los productos del catálogo."
                       Style="{StaticResource PageSubtitleText}" />
		</StackPanel>

		<!-- ===================== FORMULARIO ALTA / EDICIÓN ===================== -->
		<Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
			<StackPanel>
				<StackPanel Orientation="Horizontal" Margin="0,0,0,12">
					<ui:SymbolIcon Symbol="Box24" FontSize="18" Foreground="{StaticResource FarmaPrimaryBrush}" />
					<TextBlock x:Name="TituloFormularioText" Text="Nuevo producto" FontWeight="SemiBold"
                               FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center" />
				</StackPanel>

				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="2*" />
						<ColumnDefinition Width="1.4*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<StackPanel Grid.Column="0" Margin="0,0,10,0">
						<TextBlock Text="Descripción" Style="{StaticResource FieldLabelText}" />
						<TextBox x:Name="DescripcionText" MaxLength="150" />
					</StackPanel>
					<StackPanel Grid.Column="1" Margin="0,0,10,0">
						<TextBlock Text="Categoría" Style="{StaticResource FieldLabelText}" />
						<ComboBox x:Name="CategoriaCombo" DisplayMemberPath="Nombre" />
					</StackPanel>
					<StackPanel Grid.Column="2" Margin="0,0,10,0">
						<TextBlock Text="Precio ($)" Style="{StaticResource FieldLabelText}" />
						<TextBox x:Name="PrecioText" h:ValidacionEntrada.Tipo="Decimal" MaxLength="11" ToolTip="Ej.: 8450,50" />
					</StackPanel>
					<StackPanel Grid.Column="3">
						<TextBlock Text="Stock (unidades)" Style="{StaticResource FieldLabelText}" />
						<TextBox x:Name="StockText" h:ValidacionEntrada.Tipo="Entero" MaxLength="6" />
					</StackPanel>
				</Grid>

				<Grid Margin="0,14,0,0">
					<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
						<CheckBox x:Name="RequiereRecetaCheck" Content="Requiere receta" Margin="0,0,20,0" />
						<CheckBox x:Name="EsMedicamentoCheck" Content="Es medicamento" />
					</StackPanel>
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
						<TextBlock x:Name="MensajeText" Foreground="{StaticResource FarmaDangerBrush}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap" MaxWidth="420" />
						<ui:Button x:Name="CancelarButton" Content="Cancelar" Margin="0,0,8,0"
                                   Click="CancelarButton_Click" Visibility="Collapsed" />
						<ui:Button x:Name="GuardarButton" Content="Guardar" Appearance="Primary"
                                   Icon="{ui:SymbolIcon Save24}" Click="GuardarButton_Click" />
					</StackPanel>
				</Grid>
			</StackPanel>
		</Border>

		<!-- ===================== LISTADO ===================== -->
		<Border Grid.Row="2" Style="{StaticResource CardStyle}">
			<DockPanel>
				<TextBlock DockPanel.Dock="Top" Text="Catálogo" FontWeight="SemiBold" Margin="0,0,0,10" />
				<DataGrid x:Name="ProductosGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          RowHeight="40"
                          Background="Transparent"
                          BorderThickness="0">
					<DataGrid.Columns>
						<DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="2*" />
						<DataGridTemplateColumn Header="Categoría" Width="1.4*">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Border Style="{StaticResource EtiquetaNeutra}">
										<TextBlock Text="{Binding Categoria.Nombre}" />
									</Border>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
						<DataGridTextColumn Header="Precio" Binding="{Binding PrecioVenta, StringFormat='$ {0:N2}'}" Width="*" />
						<DataGridTextColumn Header="Stock" Binding="{Binding StockVenta}" Width="70" />
						<DataGridTextColumn Header="Receta" Binding="{Binding RequiereRecetaTexto}" Width="70" />
						<DataGridTemplateColumn Header="Estado" Width="100">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Border Style="{StaticResource EstadoTextoBadge}">
										<TextBlock Text="{Binding EstadoTexto}" />
									</Border>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
						<DataGridTemplateColumn Header="Acciones" Width="1.3*">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<StackPanel Orientation="Horizontal">
										<ui:HyperlinkButton Content="Editar" Padding="0" Margin="0,0,12,0"
                                                            Click="EditarProducto_Click" Tag="{Binding}" />
										<ui:HyperlinkButton Content="{Binding TextoAccionEstado}" Padding="0"
                                                            Click="CambiarEstadoProducto_Click" Tag="{Binding}" />
									</StackPanel>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
					</DataGrid.Columns>
				</DataGrid>
			</DockPanel>
		</Border>
	</Grid>
</Page>
