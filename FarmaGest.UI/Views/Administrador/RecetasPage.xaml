<Page x:Class="FarmaGest.UI.Views.Administrador.RecetasPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Recetas">
	<Grid Margin="26,20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<TextBlock Grid.Row="0" Text="Recetas" FontSize="20" FontWeight="Bold" Margin="0,0,0,16" />

		<Border Grid.Row="1" Style="{StaticResource CardStyle}">
			<DataGrid x:Name="RecetasGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="36"
                      Background="Transparent" BorderThickness="0">
				<DataGrid.Columns>
					<DataGridTextColumn Header="Afiliado" Binding="{Binding Afiliado}" Width="1.2*" />
					<DataGridTextColumn Header="Médico" Binding="{Binding Medico}" Width="1.2*" />
					<DataGridTextColumn Header="Emisión" Binding="{Binding FechaEmision}" Width="*" />
					<DataGridTextColumn Header="Vencimiento" Binding="{Binding FechaVencimiento}" Width="*" />
					<DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="*" />
					<DataGridTemplateColumn Header="Acciones" Width="*">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<ui:HyperlinkButton Content="Validar" Padding="0" />
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
				</DataGrid.Columns>
			</DataGrid>
		</Border>
	</Grid>
</Page>