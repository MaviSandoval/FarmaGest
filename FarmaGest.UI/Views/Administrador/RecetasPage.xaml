<Page x:Class="FarmaGest.UI.Views.Administrador.RecetasPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:h="clr-namespace:FarmaGest.UI.Helpers"
      Title="Recetas">

	<!-- Consulta de recetas. La validación es exclusiva del Farmacéutico. -->

	<Page.Resources>
		<ResourceDictionary Source="/FarmaGest.UI;component/Views/Farmaceutico/EstilosFarmaceutico.xaml" />
	</Page.Resources>

	<Grid Margin="26,20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!-- ===================== ENCABEZADO ===================== -->
		<StackPanel Grid.Row="0" Margin="0,0,0,16">
			<TextBlock Text="Recetas" Style="{StaticResource PageTitleText}" />
			<TextBlock Text="Consulta de las recetas registradas. La validación la realiza únicamente el Farmacéutico."
                       Style="{StaticResource PageSubtitleText}" />
		</StackPanel>

		<!-- ===================== KPIs ===================== -->
		<UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
			<Border Style="{StaticResource CardStyle}" Margin="0,0,8,0">
				<StackPanel>
					<TextBlock Text="Pendientes" Style="{StaticResource KpiLabelText}" />
					<TextBlock x:Name="PendientesText" Text="0" Style="{StaticResource KpiValueText}" Foreground="{StaticResource FarmaWarningBrush}" />
				</StackPanel>
			</Border>
			<Border Style="{StaticResource CardStyle}" Margin="4,0">
				<StackPanel>
					<TextBlock Text="Validadas" Style="{StaticResource KpiLabelText}" />
					<TextBlock x:Name="ValidadasMesText" Text="0" Style="{StaticResource KpiValueText}" Foreground="{StaticResource FarmaSuccessBrush}" />
				</StackPanel>
			</Border>
			<Border Style="{StaticResource CardStyle}" Margin="4,0">
				<StackPanel>
					<TextBlock Text="Rechazadas" Style="{StaticResource KpiLabelText}" />
					<TextBlock x:Name="RechazadasMesText" Text="0" Style="{StaticResource KpiValueText}" Foreground="{StaticResource FarmaDangerBrush}" />
				</StackPanel>
			</Border>
			<Border Style="{StaticResource CardStyle}" Margin="8,0,0,0">
				<StackPanel>
					<TextBlock Text="Usadas en ventas" Style="{StaticResource KpiLabelText}" />
					<TextBlock x:Name="UsadasText" Text="0" Style="{StaticResource KpiValueText}" />
				</StackPanel>
			</Border>
		</UniformGrid>

		<!-- ===================== FILTROS ===================== -->
		<Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,16" Padding="18,14">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="180" />
					<ColumnDefinition Width="200" />
				</Grid.ColumnDefinitions>
				<ui:TextBox x:Name="BuscarText" Grid.Column="0" PlaceholderText="Buscar por N° de receta, paciente, N° de afiliado o médico..."
                            Icon="{ui:SymbolIcon Search24}" Margin="0,0,12,0"
                            h:ValidacionEntrada.Tipo="Alfanumerico" MaxLength="60"
                            TextChanged="Filtro_Changed" />
				<ComboBox x:Name="EstadoCombo" Grid.Column="1" SelectedIndex="0" Margin="0,0,12,0" SelectionChanged="Filtro_Changed">
					<ComboBoxItem Content="Todos los estados" />
					<ComboBoxItem Content="Pendientes" />
					<ComboBoxItem Content="Validadas" />
					<ComboBoxItem Content="Rechazadas" />
				</ComboBox>
				<ComboBox x:Name="ObraSocialCombo" Grid.Column="2" SelectionChanged="Filtro_Changed" />
			</Grid>
		</Border>

		<!-- ===================== LISTADO ===================== -->
		<Border Grid.Row="3" Style="{StaticResource CardStyle}">
			<DataGrid x:Name="RecetasGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="40"
                      Background="Transparent" BorderThickness="0">
				<DataGrid.Columns>
					<DataGridTextColumn Header="N°" Binding="{Binding Numero}" Width="60" />
					<DataGridTextColumn Header="Afiliado" Binding="{Binding Paciente}" Width="1.3*" />
					<DataGridTextColumn Header="Obra social" Binding="{Binding ObraSocialPlan}" Width="1.3*" />
					<DataGridTextColumn Header="Médico" Binding="{Binding Medico}" Width="1.3*" />
					<DataGridTextColumn Header="Emisión" Binding="{Binding FechaEmision, StringFormat='dd/MM/yyyy'}" Width="90" />
					<DataGridTextColumn Header="Vence" Binding="{Binding FechaVencimiento, StringFormat='dd/MM/yyyy'}" Width="90" />
					
					<DataGridTextColumn Header="Uso" Binding="{Binding UsoTexto}" Width="90" />
					<DataGridTemplateColumn Header="Estado" Width="110">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<Border Style="{StaticResource EstadoBadge}">
									<TextBlock Text="{Binding Estado}" />
								</Border>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
					<DataGridTemplateColumn Header="Detalle" Width="70">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<ui:HyperlinkButton Content="Ver" Padding="0" Click="VerDetalle_Click" Tag="{Binding}" />
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
				</DataGrid.Columns>
			</DataGrid>
		</Border>
	</Grid>
</Page>
