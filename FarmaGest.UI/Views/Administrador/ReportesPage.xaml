<Page x:Class="FarmaGest.UI.Views.Administrador.ReportesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      Title="Reportes">

	<!-- Reportes del Administrador: copias de seguridad y usuarios (los de ventas son del Farmacéutico) -->

	<Page.Resources>
		<ResourceDictionary Source="/FarmaGest.UI;component/Views/Farmaceutico/EstilosFarmaceutico.xaml" />
	</Page.Resources>

	<ScrollViewer x:Name="ScrollPrincipal" VerticalScrollBarVisibility="Auto">
	<Grid Margin="26,20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!-- ===================== ENCABEZADO ===================== -->
		<Grid Grid.Row="0" Margin="0,0,0,16">
			<StackPanel>
				<TextBlock Text="Reportes del sistema" Style="{StaticResource PageTitleText}" />
				<TextBlock Text="Copias de seguridad de la base de datos y usuarios del sistema."
				           Style="{StaticResource PageSubtitleText}" />
			</StackPanel>
			<StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
				<ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon ArrowDownload24}"
				           Content="Informe PDF" Click="ExportarPdf_Click" Margin="0,0,8,0"
				           ToolTip="Informe completo: indicadores, copias de seguridad del período, usuarios y usuarios por rol" />
				<ui:Button Appearance="Primary" Icon="{ui:SymbolIcon ArrowDownload24}"
				           Content="Exportar Excel" Click="ExportarCsv_Click"
				           ToolTip="Exporta la pestaña que estés viendo (CSV, se abre con Excel)" />
			</StackPanel>
		</Grid>

		<!-- ===================== FILTRO DE PERÍODO ===================== -->
		<Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16" Padding="18,14">
			<StackPanel Orientation="Horizontal">
				<StackPanel Margin="0,0,12,0">
					<TextBlock Text="Desde" Style="{StaticResource FieldLabelText}" />
					<DatePicker x:Name="DesdePicker" Width="160" />
				</StackPanel>
				<StackPanel Margin="0,0,12,0">
					<TextBlock Text="Hasta" Style="{StaticResource FieldLabelText}" />
					<DatePicker x:Name="HastaPicker" Width="160" />
				</StackPanel>
				<ui:Button Content="Generar" Appearance="Primary" Icon="{ui:SymbolIcon ArrowSync24}"
				           VerticalAlignment="Bottom" Click="Generar_Click" />

				<Border Width="1" Background="#E3ECEA" Margin="18,4,18,0" />

				<StackPanel>
					<TextBlock Text="Accesos rápidos" Style="{StaticResource FieldLabelText}" />
					<StackPanel Orientation="Horizontal">
						<ui:Button Content="Últimos 7 días" Appearance="Secondary" Tag="7" Click="Rapido_Click" Margin="0,0,6,0" />
						<ui:Button Content="Últimos 30 días" Appearance="Secondary" Tag="30" Click="Rapido_Click" Margin="0,0,6,0" />
						<ui:Button Content="Trimestre" Appearance="Secondary" Tag="90" Click="Rapido_Click" />
					</StackPanel>
				</StackPanel>
			</StackPanel>
		</Border>

		<!-- ===================== INDICADORES ===================== -->
		<UniformGrid Grid.Row="2" Rows="1" Columns="4" Margin="0,0,0,16">
			<Border Style="{StaticResource CardStyle}" Margin="0,0,8,0" Padding="18,14">
				<StackPanel>
					<TextBlock Text="Última copia de seguridad" Style="{StaticResource KpiTitulo}" />
					<TextBlock x:Name="UltimaCopiaText" Text="—" Style="{StaticResource KpiValor}" FontSize="22" />
					<TextBlock x:Name="UltimaCopiaDetalleText" Text="—" Style="{StaticResource KpiDetalle}" />
				</StackPanel>
			</Border>
			<Border Style="{StaticResource CardStyle}" Margin="4,0" Padding="18,14">
				<StackPanel>
					<TextBlock Text="Copias en el período" Style="{StaticResource KpiTitulo}" />
					<TextBlock x:Name="CopiasText" Text="—" Style="{StaticResource KpiValor}" FontSize="22" />
					<TextBlock x:Name="CopiasDetalleText" Text="—" Style="{StaticResource KpiDetalle}" />
				</StackPanel>
			</Border>
			<Border Style="{StaticResource CardStyle}" Margin="4,0" Padding="18,14">
				<StackPanel>
					<TextBlock Text="Backup automático" Style="{StaticResource KpiTitulo}" />
					<TextBlock x:Name="AutomaticoText" Text="—" Style="{StaticResource KpiValor}" FontSize="22" />
					<TextBlock x:Name="AutomaticoDetalleText" Text="—" Style="{StaticResource KpiDetalle}" />
				</StackPanel>
			</Border>
			<Border Style="{StaticResource CardStyle}" Margin="8,0,0,0" Padding="18,14">
				<StackPanel>
					<TextBlock Text="Usuarios activos" Style="{StaticResource KpiTitulo}" />
					<TextBlock x:Name="UsuariosText" Text="—" Style="{StaticResource KpiValor}" FontSize="22" />
					<TextBlock x:Name="UsuariosDetalleText" Text="—" Style="{StaticResource KpiDetalle}" />
				</StackPanel>
			</Border>
		</UniformGrid>

		<!-- ===================== REPORTES ===================== -->
		<Border Grid.Row="3" Style="{StaticResource CardStyle}">
			<TabControl x:Name="ReportesTabs">

				<!-- 1. Copias de seguridad -->
				<TabItem Header="Copias de seguridad">
					<Grid Margin="0,12,0,0">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>
						<Border x:Name="BackupsChartCard" Style="{StaticResource GraficoCard}">
							<StackPanel>
								<TextBlock Text="Copias por día (automáticas y manuales)" Style="{StaticResource GraficoTitulo}" />
								<lvc:CartesianChart x:Name="BackupsChart" Height="210" />
							</StackPanel>
						</Border>
						<TextBlock x:Name="BackupsVacioText" Grid.Row="1" Visibility="Collapsed" Margin="4,8"
						           Text="No hay copias de seguridad en el período elegido."
						           FontSize="12.5" Foreground="{StaticResource FarmaTextMutedBrush}" />
						<DataGrid x:Name="BackupsGrid" Grid.Row="1"
						          AutoGenerateColumns="False" IsReadOnly="True"
						          HeadersVisibility="Column" GridLinesVisibility="None"
						          RowHeight="38" Background="Transparent" BorderThickness="0">
							<DataGrid.Columns>
								<DataGridTextColumn Header="Fecha" Binding="{Binding FechaTexto}" Width="1.1*" />
								<DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="0.8*" />
								<DataGridTextColumn Header="Generada por" Binding="{Binding GeneradaPor}" Width="1.1*" />
								<DataGridTextColumn Header="Archivo" Binding="{Binding Archivo}" Width="2.6*" />
								<DataGridTextColumn Header="Tamaño" Binding="{Binding Tamano}" Width="0.7*" />
								<DataGridTemplateColumn Header="Archivo .bak" Width="130">
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate>
											<Border Style="{StaticResource EstadoBadge}">
												<TextBlock Text="{Binding EstadoTexto}" />
											</Border>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>
							</DataGrid.Columns>
						</DataGrid>
					</Grid>
				</TabItem>

				<!-- 2. Usuarios -->
				<TabItem Header="Usuarios">
					<DataGrid x:Name="UsuariosGrid" Margin="0,12,0,0"
					          AutoGenerateColumns="False" IsReadOnly="True"
					          HeadersVisibility="Column" GridLinesVisibility="None"
					          RowHeight="38" Background="Transparent" BorderThickness="0">
						<DataGrid.Columns>
							<DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}" Width="1.4*" />
							<DataGridTextColumn Header="DNI" Binding="{Binding Dni}" Width="*" />
							<DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.6*" />
							<DataGridTextColumn Header="Rol" Binding="{Binding Rol}" Width="*" />
							<DataGridTextColumn Header="Debe cambiar contraseña" Binding="{Binding CambioPendienteTexto}" Width="1.1*" />
							<DataGridTemplateColumn Header="Estado" Width="100">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<Border Style="{StaticResource EstadoBadge}">
											<TextBlock Text="{Binding Estado}" />
										</Border>
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>
						</DataGrid.Columns>
					</DataGrid>
				</TabItem>

				<!-- 3. Usuarios por rol -->
				<TabItem Header="Usuarios por rol">
					<Grid Margin="0,12,0,0">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>
						<Border x:Name="RolesChartCard" Style="{StaticResource GraficoCard}">
							<StackPanel>
								<TextBlock Text="Usuarios activos por rol" Style="{StaticResource GraficoTitulo}" />
								<lvc:PieChart x:Name="RolesChart" Height="210" />
							</StackPanel>
						</Border>
						<DataGrid x:Name="RolesGrid" Grid.Row="1"
						          AutoGenerateColumns="False" IsReadOnly="True"
						          HeadersVisibility="Column" GridLinesVisibility="None"
						          RowHeight="38" Background="Transparent" BorderThickness="0">
							<DataGrid.Columns>
								<DataGridTextColumn Header="Rol" Binding="{Binding Rol}" Width="*" />
								<DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="2*" />
								<DataGridTextColumn Header="Activos" Binding="{Binding Activos}" Width="0.7*" />
								<DataGridTextColumn Header="Inactivos" Binding="{Binding Inactivos}" Width="0.7*" />
								<DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="0.7*" />
								<DataGridTextColumn Header="Deben cambiar contraseña" Binding="{Binding CambioPendiente}" Width="1.2*" />
							</DataGrid.Columns>
						</DataGrid>
					</Grid>
				</TabItem>
			</TabControl>
		</Border>
	</Grid>
	</ScrollViewer>
</Page>
