<Page x:Class="FarmaGest.UI.Views.Administrador.ReportesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Reportes">

	<!-- Reportes del período elegido (datos de la base) -->

	<Page.Resources>
		<ResourceDictionary Source="/FarmaGest.UI;component/Views/Farmaceutico/EstilosFarmaceutico.xaml" />
	</Page.Resources>

	<Grid Margin="26,20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!-- ===================== ENCABEZADO ===================== -->
		<Grid Grid.Row="0" Margin="0,0,0,16">
			<StackPanel>
				<TextBlock Text="Reportes" Style="{StaticResource PageTitleText}" />
				<TextBlock Text="Información cruzada de ventas, obras sociales, productos, cajas y cobros."
                           Style="{StaticResource PageSubtitleText}" />
			</StackPanel>
			<StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
				<ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon DocumentTable24}"
                           Content="Excel (CSV)" Click="ExportarCsv_Click" Margin="0,0,8,0" />
				<ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon DocumentPdf24}"
                           Content="PDF" Click="ExportarPdf_Click" />
			</StackPanel>
		</Grid>

		<!-- ===================== FILTRO DE PERÍODO ===================== -->
		<Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16" Padding="18,14">
			<StackPanel Orientation="Horizontal">
				<StackPanel Margin="0,0,12,0">
					<TextBlock Text="Desde" Style="{StaticResource FieldLabelText}" />
					<DatePicker x:Name="DesdePicker" Width="160" />
				</StackPanel>
				<StackPanel Margin="0,0,12,0">
					<TextBlock Text="Hasta" Style="{StaticResource FieldLabelText}" />
					<DatePicker x:Name="HastaPicker" Width="160" />
				</StackPanel>
				<ui:Button Content="Generar" Appearance="Primary" Icon="{ui:SymbolIcon ArrowSync24}"
                           VerticalAlignment="Bottom" Click="Generar_Click" />
			</StackPanel>
		</Border>

		<!-- ===================== REPORTES ===================== -->
		<Border Grid.Row="2" Style="{StaticResource CardStyle}">
			<TabControl x:Name="ReportesTabs">

				<!-- Ventas por obra social -->
				<TabItem Header="Ventas por obra social">
					<DataGrid x:Name="ObraSocialGrid" Margin="0,12,0,0"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="None"
                              RowHeight="38" Background="Transparent" BorderThickness="0">
						<DataGrid.Columns>
							<DataGridTextColumn Header="Obra social" Binding="{Binding ObraSocial}" Width="1.4*" />
							<DataGridTextColumn Header="Ventas" Binding="{Binding Ventas}" Width="*" />
							<DataGridTextColumn Header="Total vendido" Binding="{Binding TotalVendido, StringFormat='$ {0:N2}'}" Width="*" />
							<DataGridTextColumn Header="Cubierto por la obra social" Binding="{Binding TotalCubierto, StringFormat='$ {0:N2}'}" Width="1.3*" />
							<DataGridTextColumn Header="Pagado por el cliente" Binding="{Binding PagadoCliente, StringFormat='$ {0:N2}'}" Width="1.2*" />
						</DataGrid.Columns>
					</DataGrid>
				</TabItem>

				<!-- Productos más vendidos -->
				<TabItem Header="Productos más vendidos">
					<DataGrid x:Name="ProductosGrid" Margin="0,12,0,0"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="None"
                              RowHeight="38" Background="Transparent" BorderThickness="0">
						<DataGrid.Columns>
							<DataGridTextColumn Header="#" Binding="{Binding Puesto}" Width="40" />
							<DataGridTextColumn Header="Producto" Binding="{Binding Producto}" Width="2*" />
							<DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="1.3*" />
							<DataGridTextColumn Header="Unidades" Binding="{Binding Unidades}" Width="*" />
							<DataGridTextColumn Header="Total vendido" Binding="{Binding Total, StringFormat='$ {0:N2}'}" Width="*" />
						</DataGrid.Columns>
					</DataGrid>
				</TabItem>

				<!-- Cajas: apertura, cobros y arqueo -->
				<TabItem Header="Cajas">
					<DataGrid x:Name="CierresGrid" Margin="0,12,0,0"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="None"
                              RowHeight="38" Background="Transparent" BorderThickness="0">
						<DataGrid.Columns>
							<DataGridTextColumn Header="Caja" Binding="{Binding Caja}" Width="55" />
							<DataGridTextColumn Header="Cajero" Binding="{Binding Cajero}" Width="1.2*" />
							<DataGridTextColumn Header="Apertura" Binding="{Binding AperturaTexto}" Width="1.1*" />
							<DataGridTextColumn Header="Cierre" Binding="{Binding CierreTexto}" Width="1.1*" />
							<DataGridTextColumn Header="Monto inicial" Binding="{Binding MontoInicial, StringFormat='$ {0:N2}'}" Width="*" />
							<DataGridTextColumn Header="Cobros" Binding="{Binding Cobros}" Width="60" />
							<DataGridTextColumn Header="Efectivo" Binding="{Binding Efectivo, StringFormat='$ {0:N2}'}" Width="*" />
							<DataGridTextColumn Header="Otros medios" Binding="{Binding OtrosMedios, StringFormat='$ {0:N2}'}" Width="*" />
							<DataGridTextColumn Header="Efectivo esperado" Binding="{Binding Esperado, StringFormat='$ {0:N2}'}" Width="*" />
							<DataGridTextColumn Header="Efectivo contado" Binding="{Binding Contado, StringFormat='$ {0:N2}', TargetNullValue='—'}" Width="*" />
							<DataGridTextColumn Header="Diferencia" Binding="{Binding Diferencia, StringFormat='$ {0:N2}', TargetNullValue='—'}" Width="*" />
							<DataGridTemplateColumn Header="Resultado" Width="120">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<Border Style="{StaticResource EstadoBadge}">
											<TextBlock Text="{Binding Estado}" />
										</Border>
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>
						</DataGrid.Columns>
					</DataGrid>
				</TabItem>

				<!-- Ventas por farmacéutico -->
				<TabItem Header="Ventas por farmacéutico">
					<DataGrid x:Name="FarmaceuticosGrid" Margin="0,12,0,0"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="None"
                              RowHeight="38" Background="Transparent" BorderThickness="0">
						<DataGrid.Columns>
							<DataGridTextColumn Header="Farmacéutico" Binding="{Binding Farmaceutico}" Width="1.5*" />
							<DataGridTextColumn Header="Ventas" Binding="{Binding Ventas}" Width="*" />
							<DataGridTextColumn Header="Con receta" Binding="{Binding ConReceta}" Width="*" />
							<DataGridTextColumn Header="Anuladas" Binding="{Binding Anuladas}" Width="*" />
							<DataGridTextColumn Header="Total vendido" Binding="{Binding Total, StringFormat='$ {0:N2}'}" Width="*" />
						</DataGrid.Columns>
					</DataGrid>
				</TabItem>
				<!-- Ventas por período (semana / mes) -->
				<TabItem Header="Ventas por período">
					<Grid Margin="0,12,0,0">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>
						<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
							<TextBlock Text="Agrupar por" VerticalAlignment="Center" Margin="0,0,8,0" />
							<ComboBox x:Name="AgrupacionCombo" Width="140" SelectedIndex="0"
                                      SelectionChanged="Agrupacion_Changed">
								<ComboBoxItem Content="Semana" />
								<ComboBoxItem Content="Mes" />
							</ComboBox>
						</StackPanel>
						<DataGrid x:Name="PeriodoGrid" Grid.Row="1"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="None"
                                  RowHeight="38" Background="Transparent" BorderThickness="0">
							<DataGrid.Columns>
								<DataGridTextColumn Header="Período" Binding="{Binding Periodo}" Width="1.8*" />
								<DataGridTextColumn Header="Ventas" Binding="{Binding Ventas}" Width="0.7*" />
								<DataGridTextColumn Header="Con receta" Binding="{Binding ConReceta}" Width="0.8*" />
								<DataGridTextColumn Header="Total vendido" Binding="{Binding TotalVendido, StringFormat='$ {0:N2}'}" Width="*" />
								<DataGridTextColumn Header="Cubierto por OS" Binding="{Binding TotalCubierto, StringFormat='$ {0:N2}'}" Width="*" />
								<DataGridTextColumn Header="Pagado por el cliente" Binding="{Binding PagadoCliente, StringFormat='$ {0:N2}'}" Width="*" />
								<DataGridTextColumn Header="Ticket promedio" Binding="{Binding TicketPromedio, StringFormat='$ {0:N2}'}" Width="*" />
							</DataGrid.Columns>
						</DataGrid>
					</Grid>
				</TabItem>

				<!-- Cobros por medio de pago -->
				<TabItem Header="Medios de pago">
					<DataGrid x:Name="MediosPagoGrid" Margin="0,12,0,0"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="None"
                              RowHeight="38" Background="Transparent" BorderThickness="0">
						<DataGrid.Columns>
							<DataGridTextColumn Header="Medio de pago" Binding="{Binding Medio}" Width="1.4*" />
							<DataGridTextColumn Header="Cobros" Binding="{Binding Cobros}" Width="*" />
							<DataGridTextColumn Header="Cajas" Binding="{Binding Cajas}" Width="*" />
							<DataGridTextColumn Header="Total cobrado" Binding="{Binding Importe, StringFormat='$ {0:N2}'}" Width="*" />
							<DataGridTextColumn Header="% del total" Binding="{Binding Porcentaje, StringFormat='{}{0:N1} %'}" Width="*" />
							<DataGridTextColumn Header="Ticket promedio" Binding="{Binding TicketPromedio, StringFormat='$ {0:N2}'}" Width="*" />
						</DataGrid.Columns>
					</DataGrid>
				</TabItem>
			</TabControl>
		</Border>
	</Grid>
</Page>
