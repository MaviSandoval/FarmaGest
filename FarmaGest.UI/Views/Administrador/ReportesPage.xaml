<Page x:Class="FarmaGest.UI.Views.Administrador.ReportesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Reportes">
	<Grid Margin="26,20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<TextBlock Grid.Row="0" Text="Reportes" FontSize="20" FontWeight="Bold" Margin="0,0,0,16" />

		<UniformGrid Grid.Row="1" Columns="3" Rows="1">
			<Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
				<StackPanel>
					<TextBlock Text="Ventas por obra social" FontWeight="SemiBold" Margin="0,0,0,8" />
					<TextBlock Text="Reporte próximamente" Foreground="{StaticResource FarmaTextMutedBrush}" />
				</StackPanel>
			</Border>
			<Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
				<StackPanel>
					<TextBlock Text="Productos más vendidos" FontWeight="SemiBold" Margin="0,0,0,8" />
					<TextBlock Text="Reporte próximamente" Foreground="{StaticResource FarmaTextMutedBrush}" />
				</StackPanel>
			</Border>
			<Border Style="{StaticResource CardStyle}">
				<StackPanel>
					<TextBlock Text="Cierres de caja" FontWeight="SemiBold" Margin="0,0,0,8" />
					<TextBlock Text="Reporte próximamente" Foreground="{StaticResource FarmaTextMutedBrush}" />
				</StackPanel>
			</Border>
		</UniformGrid>
	</Grid>
</Page>