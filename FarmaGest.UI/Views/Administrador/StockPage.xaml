<Page x:Class="FarmaGest.UI.Views.Administrador.StockPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Stock">
	<Grid Margin="26,20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<TextBlock Grid.Row="0" Text="Control de stock" FontSize="20" FontWeight="Bold" Margin="0,0,0,16" />

		<Border Grid.Row="1" Style="{StaticResource CardStyle}">
			<DataGrid x:Name="StockGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="36"
                      Background="Transparent" BorderThickness="0">
				<DataGrid.Columns>
					<DataGridTextColumn Header="Producto" Binding="{Binding Descripcion}" Width="2*" />
					<DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="*" />
					<DataGridTextColumn Header="Stock actual" Binding="{Binding Stock}" Width="*" />
					<DataGridTextColumn Header="Estado" Binding="{Binding EstadoStock}" Width="*" />
				</DataGrid.Columns>
			</DataGrid>
		</Border>
	</Grid>
</Page>