<Page x:Class="FarmaGest.UI.Views.Administrador.VentasPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:h="clr-namespace:FarmaGest.UI.Helpers"
      Title="Ventas">

	<!-- Historial de ventas (solo consulta) -->

	<Page.Resources>
		<ResourceDictionary Source="/FarmaGest.UI;component/Views/Farmaceutico/EstilosFarmaceutico.xaml" />
	</Page.Resources>

	<Grid Margin="26,20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!-- ===================== ENCABEZADO ===================== -->
		<Grid Grid.Row="0" Margin="0,0,0,16">
			<StackPanel>
				<TextBlock Text="Ventas" Style="{StaticResource PageTitleText}" />
				<TextBlock Text="Historial de ventas: quién la armó, quién la cobró y cómo se pagó."
                           Style="{StaticResource PageSubtitleText}" />
			</StackPanel>
			<ui:Button HorizontalAlignment="Right" VerticalAlignment="Center" Appearance="Secondary"
                       Icon="{ui:SymbolIcon ArrowDownload24}" Content="Exportar" Click="Exportar_Click" />
		</Grid>

		<!-- ===================== KPIs ===================== -->
		<UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
			<Border Style="{StaticResource CardStyle}" Margin="0,0,8,0">
				<StackPanel>
					<TextBlock Text="Ventas de hoy" Style="{StaticResource KpiLabelText}" />
					<TextBlock x:Name="VentasHoyText" Text="0" Style="{StaticResource KpiValueText}" />
				</StackPanel>
			</Border>
			<Border Style="{StaticResource CardStyle}" Margin="4,0">
				<StackPanel>
					<TextBlock Text="Facturado hoy" Style="{StaticResource KpiLabelText}" />
					<TextBlock x:Name="FacturadoHoyText" Text="0" Style="{StaticResource KpiValueText}" Foreground="{StaticResource FarmaSuccessBrush}" />
				</StackPanel>
			</Border>
			<Border Style="{StaticResource CardStyle}" Margin="4,0">
				<StackPanel>
					<TextBlock Text="Pendientes de cobro" Style="{StaticResource KpiLabelText}" />
					<TextBlock x:Name="PendientesText" Text="0" Style="{StaticResource KpiValueText}" Foreground="{StaticResource FarmaWarningBrush}" />
				</StackPanel>
			</Border>
			<Border Style="{StaticResource CardStyle}" Margin="8,0,0,0">
				<StackPanel>
					<TextBlock Text="Anuladas hoy" Style="{StaticResource KpiLabelText}" />
					<TextBlock x:Name="AnuladasHoyText" Text="0" Style="{StaticResource KpiValueText}" Foreground="{StaticResource FarmaDangerBrush}" />
				</StackPanel>
			</Border>
		</UniformGrid>

		<!-- ===================== FILTROS ===================== -->
		<Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,16" Padding="18,14">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="180" />
					<ColumnDefinition Width="180" />
					<ColumnDefinition Width="160" />
				</Grid.ColumnDefinitions>
				<ui:TextBox x:Name="BuscarText" Grid.Column="0" PlaceholderText="Buscar por N° de venta, paciente o farmacéutico..."
                            Icon="{ui:SymbolIcon Search24}" Margin="0,0,12,0"
                            h:ValidacionEntrada.Tipo="Alfanumerico" MaxLength="60"
                            TextChanged="Filtro_Changed" />
				<ComboBox x:Name="EstadoCombo" Grid.Column="1" SelectedIndex="0" Margin="0,0,12,0" SelectionChanged="Filtro_Changed">
					<ComboBoxItem Content="Todos los estados" />
					<ComboBoxItem Content="Pendiente de cobro" />
					<ComboBoxItem Content="Facturada" />
					<ComboBoxItem Content="Anulada" />
				</ComboBox>
				<ComboBox x:Name="TipoCombo" Grid.Column="2" SelectedIndex="0" Margin="0,0,12,0" SelectionChanged="Filtro_Changed">
					<ComboBoxItem Content="Todos los tipos" />
					<ComboBoxItem Content="Con receta" />
					<ComboBoxItem Content="Venta libre" />
				</ComboBox>
				<DatePicker x:Name="FechaPicker" Grid.Column="3" SelectedDateChanged="Filtro_Changed"
                            ToolTip="Dejalo vacío para ver todas las fechas" />
			</Grid>
		</Border>

		<!-- ===================== LISTADO ===================== -->
		<Border Grid.Row="3" Style="{StaticResource CardStyle}">
			<DataGrid x:Name="VentasGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="40"
                      Background="Transparent" BorderThickness="0">
				<DataGrid.Columns>
					<DataGridTextColumn Header="N° venta" Binding="{Binding Numero}" Width="80" />
					<DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat='dd/MM HH:mm'}" Width="90" />
					<DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="*" />
					<DataGridTextColumn Header="Paciente / cliente" Binding="{Binding Cliente}" Width="1.5*" />
					<DataGridTextColumn Header="Armó" Binding="{Binding Responsable}" Width="*" />
					<DataGridTextColumn Header="Medio de pago" Binding="{Binding MedioPago}" Width="*" />
					<DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat='$ {0:N2}'}" Width="*" />
					<DataGridTemplateColumn Header="Estado" Width="150">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<Border Style="{StaticResource EstadoBadge}">
									<TextBlock Text="{Binding Estado}" />
								</Border>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
					<DataGridTemplateColumn Header="Detalle" Width="70">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<ui:HyperlinkButton Content="Ver" Padding="0" Click="VerDetalle_Click" Tag="{Binding}" />
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
				</DataGrid.Columns>
			</DataGrid>
		</Border>
	</Grid>
</Page>
