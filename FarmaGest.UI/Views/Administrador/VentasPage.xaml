<Page x:Class="FarmaGest.UI.Views.Administrador.VentasPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Ventas">
	<Grid Margin="26,20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<TextBlock Grid.Row="0" Text="Ventas" FontSize="20" FontWeight="Bold" Margin="0,0,0,16" />

		<Border Grid.Row="1" Style="{StaticResource CardStyle}">
			<DataGrid x:Name="VentasGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="36"
                      Background="Transparent" BorderThickness="0">
				<DataGrid.Columns>
					<DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="*" />
					<DataGridTextColumn Header="Tipo" Binding="{Binding TipoVenta}" Width="*" />
					<DataGridTextColumn Header="Receta asociada" Binding="{Binding Receta}" Width="*" />
					<DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="*" />
					<DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="*" />
				</DataGrid.Columns>
			</DataGrid>
		</Border>
	</Grid>
</Page>