<Window x:Class="FarmaGest.UI.Views.Cajero.AutorizacionAdministradorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Autorización de administrador"
        Width="430"
        Height="330"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F4F7F6">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TÍTULO -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,22">

            <TextBlock Text="Autorización requerida"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="#123B3A"/>

            <TextBlock Text="Ingrese las credenciales de un administrador para abrir la caja."
                       Margin="0,6,0,0"
                       FontSize="13"
                       Foreground="#66706E"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- USUARIO -->
        <StackPanel Grid.Row="1"
                    Margin="0,0,0,14">

            <TextBlock Text="Usuario / DNI"
                       FontWeight="SemiBold"
                       Margin="0,0,0,5"/>

            <TextBox x:Name="TxtUsuario"
                     Height="36"
                     Padding="8,5"
                     FontSize="14"/>
        </StackPanel>

        <!-- CONTRASEÑA -->
        <StackPanel Grid.Row="2"
                    Margin="0,0,0,10">

            <TextBlock Text="Contraseña"
                       FontWeight="SemiBold"
                       Margin="0,0,0,5"/>

            <PasswordBox x:Name="TxtContrasena"
                         Height="36"
                         Padding="8,5"
                         FontSize="14"/>
        </StackPanel>

        <!-- MENSAJE -->
        <TextBlock x:Name="TxtMensaje"
                   Grid.Row="3"
                   Foreground="#C62828"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,2,0,10"/>

        <!-- BOTONES -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Cancelar"
                    Width="95"
                    Height="36"
                    Margin="0,0,10,0"
                    Click="Cancelar_Click"/>

            <Button x:Name="BtnAutorizar"
                    Content="Autorizar"
                    Width="105"
                    Height="36"
                    Background="#1F7A6C"
                    Foreground="White"
                    BorderThickness="0"
                    Click="Autorizar_Click"/>

        </StackPanel>

    </Grid>
</Window>