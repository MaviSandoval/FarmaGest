<Page
    x:Class="FarmaGest.UI.Views.Cajero.CajaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="CajaPage"
    Background="{StaticResource FarmaBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===================== ENCABEZADO ===================== -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock
                    Text="Gestión de caja"
                    FontSize="26"
                    FontWeight="SemiBold"
                    Foreground="#1F2E2C" />

                <TextBlock
                    Text="Apertura, seguimiento y cierre de la caja actual."
                    Margin="0,6,0,0"
                    FontSize="13"
                    Foreground="{StaticResource FarmaTextMutedBrush}" />
            </StackPanel>

            <!-- ===================== CONTENIDO ===================== -->
            <Border
                Grid.Row="1"
                Padding="28"
                Background="White"
                CornerRadius="14">

                <Grid>

                    <!-- ===== ESTADO: CAJA CERRADA ===== -->
                    <StackPanel
                        x:Name="PanelCajaCerrada"
                        Width="420"
                        HorizontalAlignment="Left">

                        <TextBlock
                            Text="Caja cerrada"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="#1F2E2C" />

                        <TextBlock
                            Margin="0,8,0,24"
                            Text="Para comenzar a registrar ventas debe abrir una caja."
                            FontSize="13"
                            Foreground="{StaticResource FarmaTextMutedBrush}"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Margin="0,0,0,6"
                            Text="Monto inicial"
                            FontWeight="SemiBold" />

                        <TextBox
                            x:Name="TxtMontoInicial"
                            Height="42"
                            Margin="0,0,0,20"
                            Padding="12,8"
                            FontSize="14" />

                        <ui:Button
                            x:Name="BtnAbrirCaja"
                            Height="42"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Appearance="Primary"
                            Content="Abrir caja"
                            Click="AbrirCaja_Click" />
                    </StackPanel>

                    <!-- ===== ESTADO: CAJA ABIERTA ===== -->
                    <StackPanel
                        x:Name="PanelCajaAbierta"
                        Visibility="Collapsed">

                        <TextBlock
                            Text="Caja abierta"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="#1F2E2C" />

                        <TextBlock
                            x:Name="TxtFechaApertura"
                            Margin="0,6,0,24"
                            Text="Abierta desde: —"
                            FontSize="13"
                            Foreground="{StaticResource FarmaTextMutedBrush}" />

                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="200" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Monto inicial" FontWeight="SemiBold" />
                                <TextBlock
                                    x:Name="TxtMontoInicialActual"
                                    Margin="0,6,0,0"
                                    FontSize="20"
                                    Text="$ 0,00" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Total vendido" FontWeight="SemiBold" />
                                <TextBlock
                                    x:Name="TxtTotalVentas"
                                    Margin="0,6,0,0"
                                    FontSize="20"
                                    Text="$ 0,00" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Monto esperado" FontWeight="SemiBold" />
                                <TextBlock
                                    x:Name="TxtMontoEsperado"
                                    Margin="0,6,0,0"
                                    FontSize="20"
                                    Text="$ 0,00" />
                            </StackPanel>
                        </Grid>

                        <ui:Button
                            x:Name="BtnCerrarCaja"
                            Width="160"
                            Height="42"
                            HorizontalAlignment="Left"
                            Appearance="Primary"
                            Content="Cerrar caja"
                            Click="CerrarCaja_Click" />
                    </StackPanel>

                </Grid>
            </Border>

        </Grid>
    </ScrollViewer>
</Page>