<ui:FluentWindow x:Class="FarmaGest.UI.Views.Cajero.CierreCajaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:h="clr-namespace:FarmaGest.UI.Helpers"
        Title="Cierre de caja"
        Width="560"
        Height="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        Background="{StaticResource FarmaBackgroundBrush}">

    <ui:FluentWindow.Resources>
        <ResourceDictionary Source="/FarmaGest.UI;component/Views/Farmaceutico/EstilosFarmaceutico.xaml" />
    </ui:FluentWindow.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="Cierre de caja"
                     ShowMaximize="False"
                     ShowMinimize="False" />

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="26,8,26,0">

            <StackPanel>

                <TextBlock Text="Arqueo y cierre"
                           Style="{StaticResource PageTitleText}" />

                <TextBlock x:Name="TxtInfoCaja"
                           Text="Cargando información de caja..."
                           Style="{StaticResource PageSubtitleText}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,16" />

                <!-- RESUMEN -->

                <Border Style="{StaticResource CardStyle}"
                        Margin="0,0,0,12">

                    <StackPanel>

                        <TextBlock Text="Resumen"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10" />

                        <!-- MONTO INICIAL -->

                        <Grid Margin="0,0,0,6">

                            <TextBlock Text="Monto inicial"
                                       Foreground="{StaticResource FarmaTextMutedBrush}" />

                            <TextBlock x:Name="TxtMontoInicial"
                                       Text="$ 0,00"
                                       HorizontalAlignment="Right" />

                        </Grid>

                        <!-- EFECTIVO -->

                        <Grid Margin="0,0,0,6">

                            <TextBlock x:Name="TxtCantidadEfectivo"
                                       Text="Cobros en efectivo (0)"
                                       Foreground="{StaticResource FarmaTextMutedBrush}" />

                            <TextBlock x:Name="TxtTotalEfectivo"
                                       Text="$ 0,00"
                                       HorizontalAlignment="Right" />

                        </Grid>

                        <!-- EFECTIVO ESPERADO -->

                        <Border BorderBrush="#E7ECEB"
                                BorderThickness="0,1,0,0"
                                Padding="0,8,0,0"
                                Margin="0,4,0,10">

                            <Grid>

                                <TextBlock Text="Efectivo esperado en caja"
                                           FontWeight="SemiBold" />

                                <TextBlock x:Name="TxtEfectivoEsperado"
                                           Text="$ 0,00"
                                           HorizontalAlignment="Right"
                                           FontWeight="SemiBold" />

                            </Grid>

                        </Border>

                        <!-- OTROS MEDIOS -->

                        <TextBlock Text="Otros medios (no se cuentan en el cajón)"
                                   FontSize="11.5"
                                   Foreground="{StaticResource FarmaTextMutedBrush}"
                                   Margin="0,0,0,4" />

                        <Grid>

                            <TextBlock x:Name="TxtCantidadOtros"
                                       Text="Débito · Crédito · Transferencia (0)"
                                       FontSize="12"
                                       Foreground="{StaticResource FarmaTextMutedBrush}" />

                            <TextBlock x:Name="TxtTotalOtros"
                                       Text="$ 0,00"
                                       HorizontalAlignment="Right"
                                       FontSize="12" />

                        </Grid>

                    </StackPanel>

                </Border>

                <!-- ARQUEO -->

                <Border Style="{StaticResource CardStyle}">

                    <StackPanel>

                        <TextBlock Text="Arqueo"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10" />

                        <TextBlock Text="Efectivo contado ($)"
                                   Style="{StaticResource FieldLabelText}" />

                        <ui:TextBox x:Name="EfectivoContadoText"
                                    PlaceholderText="Ej.: 17000,00"
                                    h:ValidacionEntrada.Tipo="Decimal"
                                    MaxLength="12"
                                    TextChanged="EfectivoContado_TextChanged" />

                        <!-- DIFERENCIA -->

                        <Border x:Name="DiferenciaBorder"
                                Background="#F4F7F6"
                                CornerRadius="8"
                                Padding="12,10"
                                Margin="0,10,0,12">

                            <Grid>

                                <TextBlock Text="Diferencia"
                                           FontWeight="SemiBold" />

                                <TextBlock x:Name="DiferenciaText"
                                           Text="—"
                                           HorizontalAlignment="Right"
                                           FontWeight="SemiBold" />

                            </Grid>

                        </Border>

                        <!-- OBSERVACIONES -->

                        <TextBlock Text="Observaciones (obligatorio si hay diferencia)"
                                   Style="{StaticResource FieldLabelText}" />

                        <ui:TextBox x:Name="ObservacionesText"
                                    MaxLength="200"
                                    TextWrapping="Wrap"
                                    AcceptsReturn="True"
                                    Height="70"
                                    VerticalContentAlignment="Top" />

                        <TextBlock x:Name="MensajeText"
                                   Foreground="{StaticResource FarmaDangerBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

        <!-- BOTONES -->

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E7ECEB"
                BorderThickness="0,1,0,0"
                Padding="26,14">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <ui:Button Content="Cancelar"
                           Margin="0,0,8,0"
                           Click="Cancelar_Click" />

                <ui:Button Content="Confirmar cierre"
                           Appearance="Primary"
                           Icon="{ui:SymbolIcon LockClosed24}"
                           Click="Confirmar_Click" />

            </StackPanel>

        </Border>

    </Grid>

</ui:FluentWindow>