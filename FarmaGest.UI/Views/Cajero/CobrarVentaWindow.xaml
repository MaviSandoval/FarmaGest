<Window x:Class="FarmaGest.UI.Views.Cajero.CobrarVentaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cobrar venta"
        SizeToContent="Height"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F7F7">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TÍTULO -->

        <TextBlock Grid.Row="0"
                   Text="Cobrar venta"
                   FontSize="26"
                   FontWeight="SemiBold"
                   Foreground="#1F2D2D"/>

        <!-- NÚMERO DE VENTA -->

        <TextBlock Grid.Row="1"
                   x:Name="TxtNumeroVenta"
                   Text="Venta N°"
                   FontSize="14"
                   Foreground="#6B7777"
                   Margin="0,8,0,20"/>

        <!-- TOTAL -->

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                Padding="20"
                Margin="0,0,0,20">

            <StackPanel>

                <TextBlock Text="Total a cobrar"
                           FontSize="14"
                           Foreground="#6B7777"/>

                <TextBlock x:Name="TxtTotal"
                           Text="$ 0,00"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Margin="0,5,0,0"/>

            </StackPanel>

        </Border>

        <!-- MÉTODO DE PAGO -->

        <StackPanel Grid.Row="3">

            <TextBlock Text="Método de pago"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>

            <ComboBox x:Name="CmbMetodoPago"
                      Height="38"
                      FontSize="14"
                      DisplayMemberPath="Nombre"
                      SelectionChanged="CmbMetodoPago_SelectionChanged"/>

        </StackPanel>

        <!-- PANELES SEGÚN MÉTODO DE PAGO -->

        <Grid Grid.Row="4"
              Margin="0,20,0,0">

            <!-- EFECTIVO -->

            <Border x:Name="PanelEfectivo"
                    Background="White"
                    CornerRadius="10"
                    Padding="18"
                    VerticalAlignment="Top"
                    Visibility="Collapsed">

                <StackPanel>

                    <TextBlock Text="Efectivo recibido"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <TextBox x:Name="TxtEfectivoRecibido"
                             Height="38"
                             FontSize="16"
                             VerticalContentAlignment="Center"
                             TextChanged="TxtEfectivoRecibido_TextChanged"/>

                    <Grid Margin="0,18,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Vuelto"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>

                        <TextBlock Grid.Column="1"
                                   x:Name="TxtVuelto"
                                   Text="$ 0,00"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource FarmaPrimaryBrush}"/>

                    </Grid>

                </StackPanel>

            </Border>

            <!-- TARJETA: DÉBITO / CRÉDITO -->

            <Border x:Name="PanelTarjeta"
                    Background="White"
                    CornerRadius="10"
                    Padding="18"
                    VerticalAlignment="Top"
                    Visibility="Collapsed">

                <StackPanel>

                    <TextBlock x:Name="TxtTituloTarjeta"
                               Text="Datos de tarjeta"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,15"/>

                    <!-- TITULAR -->

                    <TextBlock Text="Titular"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>

                    <TextBox x:Name="TxtTitularTarjeta"
                             Height="36"
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             Margin="0,0,0,12"/>

                    <!-- NÚMERO DE TARJETA -->

                    <TextBlock Text="Número de tarjeta"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>

                    <TextBox x:Name="TxtNumeroTarjeta"
                             Height="36"
                             FontSize="14"
                             MaxLength="19"
                             VerticalContentAlignment="Center"
                             Margin="0,0,0,12"/>

                    <!-- VENCIMIENTO Y CVV -->

                    <Grid Margin="0,0,0,12">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="Vencimiento (MM/AA)"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"/>

                            <TextBox x:Name="TxtVencimiento"
                                     Height="36"
                                     FontSize="14"
                                     MaxLength="5"
                                     VerticalContentAlignment="Center"/>

                        </StackPanel>

                        <StackPanel Grid.Column="2">

                            <TextBlock Text="CVV"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"/>

                            <PasswordBox x:Name="TxtCvv"
                                         Height="36"
                                         FontSize="14"
                                         MaxLength="4"
                                         VerticalContentAlignment="Center"/>

                        </StackPanel>

                    </Grid>

                    <!-- CUOTAS: SOLO CRÉDITO -->

                    <StackPanel x:Name="PanelCuotas"
                                Visibility="Collapsed">

                        <TextBlock Text="Cuotas"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5"/>

                        <ComboBox x:Name="CmbCuotas"
                                  Height="36"
                                  FontSize="14"
                                  SelectedIndex="0">

                            <ComboBoxItem Content="1"/>
                            <ComboBoxItem Content="3"/>
                            <ComboBoxItem Content="6"/>
                            <ComboBoxItem Content="12"/>

                        </ComboBox>

                    </StackPanel>

                </StackPanel>

            </Border>

            <!-- TRANSFERENCIA -->

            <Border x:Name="PanelTransferencia"
                    Background="White"
                    CornerRadius="10"
                    Padding="18"
                    VerticalAlignment="Top"
                    Visibility="Collapsed">

                <StackPanel>

                    <TextBlock Text="Datos de transferencia"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="Número de operación / comprobante"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>

                    <TextBox x:Name="TxtNumeroOperacion"
                             Height="38"
                             FontSize="14"
                             MaxLength="100"
                             VerticalContentAlignment="Center"/>

                </StackPanel>

            </Border>

        </Grid>

        <!-- BOTONES -->

        <Grid Grid.Row="5"
              Margin="0,25,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    Content="Cancelar"
                    Width="100"
                    Height="38"
                    Margin="0,0,10,0"
                    IsCancel="True"
                    Click="Cancelar_Click"/>

            <Button Grid.Column="2"
                    Content="Confirmar cobro"
                    Width="140"
                    Height="38"
                    Background="{StaticResource FarmaPrimaryBrush}"
                    Foreground="White"
                    BorderThickness="0"
                    IsDefault="True"
                    Click="Confirmar_Click"/>

        </Grid>

    </Grid>

</Window>