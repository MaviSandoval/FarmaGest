<Page
    x:Class="FarmaGest.UI.Views.Cajero.PreventasPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="PreventasPage"
    Background="{StaticResource FarmaBackgroundBrush}">

    <Grid Margin="32">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===================== ENCABEZADO ===================== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">

            <TextBlock
                Text="Preventas"
                FontSize="26"
                FontWeight="SemiBold"
                Foreground="#1F2E2C" />

            <TextBlock
                Margin="0,6,0,0"
                Text="Ventas preparadas por farmacéuticos o vendedores pendientes de cobro."
                FontSize="13"
                Foreground="{StaticResource FarmaTextMutedBrush}" />

        </StackPanel>

        <!-- ===================== RESUMEN ===================== -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,20"
            Padding="20"
            Background="White"
            CornerRadius="12">

            <StackPanel Orientation="Horizontal">

                <TextBlock
                    Text="Preventas pendientes:"
                    FontWeight="SemiBold"
                    FontSize="14" />

                <TextBlock
                    x:Name="TxtCantidadPreventas"
                    Margin="8,0,0,0"
                    Text="0"
                    FontWeight="Bold"
                    FontSize="14" />

            </StackPanel>

        </Border>

        <!-- ===================== LISTADO ===================== -->
        <Border
            Grid.Row="2"
            Padding="20"
            Background="White"
            CornerRadius="12">

            <DataGrid
                x:Name="DgPreventas"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                IsReadOnly="True"
                SelectionMode="Single"
                HeadersVisibility="Column"
                GridLinesVisibility="Horizontal"
                BorderThickness="0">

                <DataGrid.Columns>

                    <DataGridTextColumn
                        Header="Fecha"
                        Binding="{Binding Fecha}"
                        Width="130" />

                    <DataGridTextColumn
                        Header="Hora"
                        Binding="{Binding Hora}"
                        Width="90" />

                    <DataGridTextColumn
                        Header="N° Venta"
                        Binding="{Binding NumeroVenta}"
                        Width="100" />

                    <DataGridTextColumn
                        Header="Vendedor / Farmacéutico"
                        Binding="{Binding Responsable}"
                        Width="*" />

                    <DataGridTextColumn
                        Header="Productos"
                        Binding="{Binding CantidadProductos}"
                        Width="100" />

                    <DataGridTextColumn
                        Header="Total"
                        Binding="{Binding Total}"
                        Width="130" />

                    <DataGridTextColumn
                        Header="Estado"
                        Binding="{Binding Estado}"
                        Width="120" />

                    <DataGridTemplateColumn
                        Header="Acción"
                        Width="120">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <ui:Button
                                    Content="Cobrar"
                                    Appearance="Primary"
                                    Padding="14,6"
                                    Click="Cobrar_Click" />

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</Page>