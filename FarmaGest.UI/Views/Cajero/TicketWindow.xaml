<ui:FluentWindow x:Class="FarmaGest.UI.Views.Cajero.TicketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Ticket"
        Width="440" Height="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        Background="{StaticResource FarmaBackgroundBrush}">

	<ui:FluentWindow.Resources>
		<ResourceDictionary Source="/FarmaGest.UI;component/Views/Farmaceutico/EstilosFarmaceutico.xaml" />
	</ui:FluentWindow.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<ui:TitleBar Grid.Row="0" Title="Ticket de venta" ShowMaximize="False" ShowMinimize="False" />

		<!-- ===================== TICKET (estilo comprobante impreso) ===================== -->
		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,8,24,0">
			<Border Background="White" Padding="22,20" CornerRadius="4" BorderBrush="#E7ECEB" BorderThickness="1">
				<StackPanel TextElement.FontFamily="Consolas" TextElement.FontSize="12.5" TextElement.Foreground="#1F2E2C">

					<!-- Datos del comercio -->
					<TextBlock Text="FARMA GEST" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" />
					<TextBlock Text="Farmacia · Corrientes Capital" HorizontalAlignment="Center" />
					<TextBlock Text="Av. Ejemplo 1234 · Tel. 0379-400-0000" HorizontalAlignment="Center" />
					<TextBlock Text="- - - - - - - - - - - - - - - - - - -" HorizontalAlignment="Center" Margin="0,8" />

					<!-- Datos del comprobante -->
					<TextBlock Text="Ticket N° 0001-00001046" FontWeight="Bold" />
					<TextBlock Text="Fecha: 23/09/2026 11:31" />
					<TextBlock Text="Venta N° 1046" />
					<TextBlock Text="Preparó: Farmacéutico Sistema" />
					<TextBlock Text="Cobró:   Cajero Sistema" />
					<TextBlock Text="- - - - - - - - - - - - - - - - - - -" HorizontalAlignment="Center" Margin="0,8" />

					<!-- Detalle de productos -->
					<ItemsControl x:Name="DetalleList">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<StackPanel Margin="0,0,0,6">
									<TextBlock Text="{Binding Producto}" TextWrapping="Wrap" />
									<Grid>
										<TextBlock Text="{Binding Linea}" />
										<TextBlock Text="{Binding Subtotal, StringFormat='$ {0:N2}'}" HorizontalAlignment="Right" />
									</Grid>
									<Grid Visibility="{Binding TieneDescuento, Converter={StaticResource BoolToVis}}">
										<TextBlock Text="{Binding TextoDescuento}" Foreground="#1F7A6C" />
										<TextBlock Text="{Binding Descuento, StringFormat='- $ {0:N2}'}" HorizontalAlignment="Right" Foreground="#1F7A6C" />
									</Grid>
								</StackPanel>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<TextBlock Text="- - - - - - - - - - - - - - - - - - -" HorizontalAlignment="Center" Margin="0,4,0,8" />

					<!-- Totales -->
					<Grid>
						<TextBlock Text="Subtotal" />
						<TextBlock x:Name="SubtotalText" HorizontalAlignment="Right" />
					</Grid>
					<Grid>
						<TextBlock Text="Cobertura obra social" />
						<TextBlock x:Name="DescuentoText" HorizontalAlignment="Right" />
					</Grid>
					<Grid Margin="0,6,0,0">
						<TextBlock Text="TOTAL" FontSize="16" FontWeight="Bold" />
						<TextBlock x:Name="TotalText" HorizontalAlignment="Right" FontSize="16" FontWeight="Bold" />
					</Grid>

					<TextBlock Text="- - - - - - - - - - - - - - - - - - -" HorizontalAlignment="Center" Margin="0,8" />

					<!-- Pago -->
					<Grid>
						<TextBlock Text="Medio de pago" />
						<TextBlock Text="Efectivo" HorizontalAlignment="Right" />
					</Grid>
					<Grid>
						<TextBlock Text="Paga con" />
						<TextBlock Text="$ 10.000,00" HorizontalAlignment="Right" />
					</Grid>
					<Grid>
						<TextBlock Text="Vuelto" />
						<TextBlock Text="$ 230,00" HorizontalAlignment="Right" />
					</Grid>
					<TextBlock Text="Obra social: OSDE · Plan 210" Margin="0,6,0,0" />
					<TextBlock Text="Afiliado: Juan Pérez · 61-458921-02" />

					<TextBlock Text="- - - - - - - - - - - - - - - - - - -" HorizontalAlignment="Center" Margin="0,8" />
					<TextBlock Text="¡Gracias por su compra!" HorizontalAlignment="Center" FontWeight="Bold" />
					<TextBlock Text="Comprobante no válido como factura" HorizontalAlignment="Center" FontSize="11" />
				</StackPanel>
			</Border>
		</ScrollViewer>

		<!-- ===================== BOTONES ===================== -->
		<Border Grid.Row="2" Background="White" BorderBrush="#E7ECEB" BorderThickness="0,1,0,0" Padding="24,14">
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
				<ui:Button Content="Cerrar" Margin="0,0,8,0" Click="Cerrar_Click" />
				<ui:Button Content="Imprimir" Appearance="Primary" Icon="{ui:SymbolIcon Print24}" Click="Imprimir_Click" />
			</StackPanel>
		</Border>
	</Grid>
</ui:FluentWindow>
