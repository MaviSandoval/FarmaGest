<Page x:Class="FarmaGest.UI.Views.Cajero.VentasCobradasMaquetaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:h="clr-namespace:FarmaGest.UI.Helpers"
      Title="Ventas cobradas">

	<!-- MAQUETA de VentasCobradasPage con datos de ejemplo (la versión real lee la base de datos) -->

	<Page.Resources>
		<ResourceDictionary Source="/FarmaGest.UI;component/Views/Farmaceutico/EstilosFarmaceutico.xaml" />
	</Page.Resources>

	<Grid Margin="26,20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!-- ===================== ENCABEZADO ===================== -->
		<StackPanel Grid.Row="0" Margin="0,0,0,16">
			<TextBlock Text="Ventas cobradas" Style="{StaticResource PageTitleText}" />
			<TextBlock Text="Ventas facturadas y cobradas en caja."
                       Style="{StaticResource PageSubtitleText}" />
		</StackPanel>

		<!-- ===================== KPIs ===================== -->
		<UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,16">
			<Border Style="{StaticResource CardStyle}" Margin="0,0,8,0">
				<StackPanel>
					<TextBlock Text="Ventas cobradas" Style="{StaticResource KpiLabelText}" />
					<TextBlock Text="7" Style="{StaticResource KpiValueText}" />
				</StackPanel>
			</Border>
			<Border Style="{StaticResource CardStyle}" Margin="4,0">
				<StackPanel>
					<TextBlock Text="Importe total" Style="{StaticResource KpiLabelText}" />
					<TextBlock Text="$ 53.751,00" Style="{StaticResource KpiValueText}" Foreground="{StaticResource FarmaSuccessBrush}" />
				</StackPanel>
			</Border>
			<Border Style="{StaticResource CardStyle}" Margin="8,0,0,0">
				<StackPanel>
					<TextBlock Text="Ticket promedio" Style="{StaticResource KpiLabelText}" />
					<TextBlock Text="$ 7.678,71" Style="{StaticResource KpiValueText}" />
				</StackPanel>
			</Border>
		</UniformGrid>

		<!-- ===================== FILTROS ===================== -->
		<Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,16" Padding="18,14">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="200" />
					<ColumnDefinition Width="170" />
				</Grid.ColumnDefinitions>
				<ui:TextBox Grid.Column="0" PlaceholderText="Buscar por N° de venta..."
                            Icon="{ui:SymbolIcon Search24}" Margin="0,0,12,0"
                            h:ValidacionEntrada.Tipo="Entero" MaxLength="10" />
				<ComboBox Grid.Column="1" SelectedIndex="0" Margin="0,0,12,0">
					<ComboBoxItem Content="Todos los medios de pago" />
					<ComboBoxItem Content="Efectivo" />
					<ComboBoxItem Content="Débito" />
					<ComboBoxItem Content="Crédito" />
					<ComboBoxItem Content="Transferencia" />
				</ComboBox>
				<DatePicker x:Name="FechaPicker" Grid.Column="2" />
			</Grid>
		</Border>

		<!-- ===================== LISTADO ===================== -->
		<Border Grid.Row="3" Style="{StaticResource CardStyle}">
			<DataGrid x:Name="VentasGrid"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="None"
                      RowHeight="40" Background="Transparent" BorderThickness="0">
				<DataGrid.Columns>
					<DataGridTextColumn Header="Hora" Binding="{Binding Hora}" Width="70" />
					<DataGridTextColumn Header="N° venta" Binding="{Binding Numero}" Width="80" />
					<DataGridTextColumn Header="Preparada por" Binding="{Binding Responsable}" Width="*" />
					<DataGridTextColumn Header="Medio de pago" Binding="{Binding MetodoPago}" Width="130" />
					<DataGridTextColumn Header="Importe" Binding="{Binding Importe, StringFormat='$ {0:N2}'}" Width="110" />
					<DataGridTextColumn Header="Cajero" Binding="{Binding Cajero}" Width="140" />
					<DataGridTemplateColumn Header="Estado" Width="110">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<Border Style="{StaticResource EstadoBadge}">
									<TextBlock Text="{Binding Estado}" />
								</Border>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
					<DataGridTemplateColumn Header="Ticket" Width="70">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<ui:HyperlinkButton Content="Ver" Padding="0" Click="VerTicket_Click" />
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
				</DataGrid.Columns>
			</DataGrid>
		</Border>
	</Grid>
</Page>
