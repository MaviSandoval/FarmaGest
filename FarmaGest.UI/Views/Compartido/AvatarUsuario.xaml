<UserControl x:Class="FarmaGest.UI.Views.Compartido.AvatarUsuario"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="36" Height="36">

	<!-- Avatar circular: muestra la foto del usuario o, si no tiene, sus iniciales -->
	<Grid>
		<Ellipse Fill="{StaticResource FarmaAccentBrush}" />
		<TextBlock x:Name="InicialesText"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="White" FontWeight="SemiBold" />
		<Ellipse x:Name="FotoEllipse" Visibility="Collapsed" />
	</Grid>
</UserControl>
