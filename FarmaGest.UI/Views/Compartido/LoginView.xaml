<Page
    x:Class="FarmaGest.UI.Views.Compartido.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="LoginView"
    d:DesignHeight="700"
    d:DesignWidth="900"
    Background="#F3F4F6"
    mc:Ignorable="d">

	<Grid>
		<!--  Tarjeta central de login  -->
		<Border
            Width="420"
            Padding="40,44"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="White"
            CornerRadius="16">
			<Border.Effect>
				<DropShadowEffect
                    BlurRadius="24"
                    Direction="270"
                    Opacity="0.12"
                    ShadowDepth="4"
                    Color="Black" />
			</Border.Effect>

			<StackPanel>

				<!--  Ícono +  -->
				<Border
                    Width="64"
                    Height="64"
                    Margin="0,0,0,20"
                    HorizontalAlignment="Center"
                    Background="#DCFCE7"
                    CornerRadius="16">
					<ui:SymbolIcon
                        FontSize="30"
                        Foreground="#16A34A"
                        Symbol="Add24" />
				</Border>

				<!--  Título  -->
				<TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="Georgia"
                    FontSize="28"
                    FontWeight="Bold"
                    Text="FarmaGest" />

				<!--  Subtítulo  -->
				<TextBlock
                    Margin="0,6,0,20"
                    HorizontalAlignment="Center"
                    FontSize="14"
                    Foreground="#6B7280"
                    Text="Sistema de Gestión de Farmacia" />

				<!--  Mensaje de Error  -->
				<TextBlock
                    Margin="0,0,0,12"
                    HorizontalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="#DC2626"
                    Text="{Binding MensajeError}"
                    TextWrapping="Wrap" />

				<!--  Usuario  -->
				<TextBlock
                    Margin="0,0,0,6"
                    FontWeight="SemiBold"
                    Text="Usuario" />
				<ui:TextBox
                    Margin="0,0,0,18"
                    Padding="12,10"
                    FontSize="14"
                    PlaceholderText="usuario@farmacia.es"
                    Text="{Binding Usuario, UpdateSourceTrigger=PropertyChanged}" />

				<!--  Contraseña  -->
				<TextBlock
                    Margin="0,0,0,6"
                    FontWeight="SemiBold"
                    Text="Contraseña" />
				<ui:PasswordBox
                    x:Name="TxtPassword"
                    Margin="0,0,0,24"
                    Padding="12,10"
                    FontSize="14"
                    PasswordChanged="TxtPassword_PasswordChanged"
                    PlaceholderText="••••••••" />

				<!--  Botón Iniciar sesión  -->
				<ui:Button
                    Height="44"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Appearance="Primary"
                    Background="#16A34A"
                    Command="{Binding IniciarSesionCommand}"
                    Content="Iniciar sesión"
                    FontSize="14"
                    FontWeight="SemiBold" />

			</StackPanel>
		</Border>
	</Grid>
</Page>