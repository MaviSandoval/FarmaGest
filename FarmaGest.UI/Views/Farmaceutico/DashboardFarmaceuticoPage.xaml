<Page x:Class="FarmaGest.UI.Views.Farmaceutico.DashboardFarmaceuticoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Inicio">

	<ScrollViewer Padding="26,20" VerticalScrollBarVisibility="Auto">
		<StackPanel>

			<!-- ===================== FILA DE KPIs ===================== -->
			<UniformGrid Columns="5" Rows="1">
				<Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
					<StackPanel>
						<TextBlock Text="Recetas pendientes" FontSize="12" Foreground="{StaticResource FarmaTextMutedBrush}" />
						<TextBlock Text="{Binding RecetasPendientes}" FontSize="22" FontWeight="Bold" Margin="0,6,0,4" />
					</StackPanel>
				</Border>
				<Border Style="{StaticResource CardStyle}" Margin="5,0">
					<StackPanel>
						<TextBlock Text="Consultas hoy" FontSize="12" Foreground="{StaticResource FarmaTextMutedBrush}" />
						<TextBlock Text="{Binding ConsultasHoy}" FontSize="22" FontWeight="Bold" Margin="0,6,0,4" />
					</StackPanel>
				</Border>
				<Border Style="{StaticResource CardStyle}" Margin="5,0">
					<StackPanel>
						<TextBlock Text="Ventas con receta hoy" FontSize="12" Foreground="{StaticResource FarmaTextMutedBrush}" />
						<TextBlock Text="{Binding VentasConRecetaHoy}" FontSize="22" FontWeight="Bold" Margin="0,6,0,4" />
					</StackPanel>
				</Border>
				<Border Style="{StaticResource CardStyle}" Margin="5,0">
					<StackPanel>
						<TextBlock Text="Stock crítico" FontSize="12" Foreground="{StaticResource FarmaTextMutedBrush}" />
						<TextBlock Text="{Binding StockCritico}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource FarmaDangerBrush}" Margin="0,6,0,4" />
					</StackPanel>
				</Border>
				<Border Style="{StaticResource CardStyle}" Margin="10,0,0,0">
					<StackPanel>
						<TextBlock Text="Vencimientos próximos" FontSize="12" Foreground="{StaticResource FarmaTextMutedBrush}" />
						<TextBlock Text="{Binding VencimientosProximos}" FontSize="22" FontWeight="Bold" Margin="0,6,0,4" />
					</StackPanel>
				</Border>
			</UniformGrid>

			<!-- ===================== RECETAS PENDIENTES ===================== -->
			<Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
				<StackPanel>
					<TextBlock Text="Recetas pendientes de validación" FontWeight="SemiBold" Margin="0,0,0,10" />

					<TextBlock Text="No hay recetas pendientes por ahora."
                               FontSize="12.5" Foreground="{StaticResource FarmaTextMutedBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,10"
                               Visibility="Collapsed" x:Name="RecetasVacioText" />

					<ItemsControl ItemsSource="{Binding RecetasPendientesList}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,10">
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="2*"/>
											<ColumnDefinition Width="2*"/>
											<ColumnDefinition Width="1.6*"/>
											<ColumnDefinition Width="1.2*"/>
										</Grid.ColumnDefinitions>

										<StackPanel Grid.Column="0">
											<TextBlock Text="{Binding Paciente}" FontSize="12.5" FontWeight="SemiBold"/>
											<TextBlock Text="Paciente" FontSize="10.5" Foreground="{StaticResource FarmaTextMutedBrush}"/>
										</StackPanel>

										<StackPanel Grid.Column="1">
											<TextBlock Text="{Binding Medicamento}" FontSize="12.5"/>
											<TextBlock Text="Medicamento" FontSize="10.5" Foreground="{StaticResource FarmaTextMutedBrush}"/>
										</StackPanel>

										<StackPanel Grid.Column="2">
											<TextBlock Text="{Binding Medico}" FontSize="12.5"/>
											<TextBlock Text="Médico" FontSize="10.5" Foreground="{StaticResource FarmaTextMutedBrush}"/>
										</StackPanel>

										<StackPanel Grid.Column="3">
											<TextBlock Text="{Binding FechaEmision, StringFormat='dd/MM/yyyy'}" FontSize="12.5"/>
											<TextBlock Text="Emisión" FontSize="10.5" Foreground="{StaticResource FarmaTextMutedBrush}"/>
										</StackPanel>
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>
			</Border>
		</StackPanel>
	</ScrollViewer>
</Page>