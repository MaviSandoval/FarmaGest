<ui:FluentWindow
    x:Class="FarmaGest.UI.Views.Farmaceutico.MainWindowFarmaceutico"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:compartido="clr-namespace:FarmaGest.UI.Views.Compartido"
    Title="Farma Gest"
    Width="1400" Height="860"
    MinWidth="1100" MinHeight="650"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica">

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="240" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<ui:TitleBar
            Grid.Row="0" Grid.ColumnSpan="2"
            Title="Farma Gest"
            ShowMaximize="True" ShowMinimize="True" />

		<!-- ===================== SIDEBAR ===================== -->
		<Border Grid.Row="1" Grid.Column="0" Background="{StaticResource FarmaSidebarBrush}">
			<DockPanel LastChildFill="False">
				<StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,22,20,26">
					<ui:SymbolIcon Symbol="Pill24" FontSize="26" Foreground="White" />
					<StackPanel Margin="10,0,0,0">
						<TextBlock Text="Farma Gest" FontSize="16" FontWeight="SemiBold" Foreground="White" />
						<TextBlock Text="Panel Farmacéutico" FontSize="10" Foreground="#9FC6BF" TextWrapping="Wrap" Width="170" />
					</StackPanel>
				</StackPanel>

				<StackPanel x:Name="NavPanel" DockPanel.Dock="Top">
					<RadioButton x:Name="NavInicio" Style="{StaticResource SidebarNavItem}" Content="Inicio" Tag="Home24" IsChecked="True" Click="NavItem_Click" />
					<RadioButton x:Name="NavRecetas" Style="{StaticResource SidebarNavItem}" Content="Validación de recetas" Tag="DocumentCheckmark24" Click="NavItem_Click" />
					<RadioButton x:Name="NavVentas" Style="{StaticResource SidebarNavItem}" Content="Ventas" Tag="Cart24" Click="NavItem_Click" />
					<RadioButton x:Name="NavProductos" Style="{StaticResource SidebarNavItem}" Content="Productos" Tag="Box24" Click="NavItem_Click" />
					<RadioButton x:Name="NavStock" Style="{StaticResource SidebarNavItem}" Content="Stock" Tag="DataHistogram24" Click="NavItem_Click" />
					<RadioButton x:Name="NavObrasSociales" Style="{StaticResource SidebarNavItem}" Content="Obras Sociales" Tag="ShieldCheckmark24" Click="NavItem_Click" />
					<RadioButton x:Name="NavReportes" Style="{StaticResource SidebarNavItem}" Content="Reportes" Tag="DataArea24" Click="NavItem_Click" />
				</StackPanel>
			</DockPanel>
		</Border>

		<!-- ===================== CONTENIDO ===================== -->
		<Grid Grid.Row="1" Grid.Column="1" Background="{StaticResource FarmaBackgroundBrush}">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<Border Grid.Row="0" Background="White" Padding="26,14" BorderThickness="0,0,0,1" BorderBrush="#E7ECEB">
				<Grid>
					<StackPanel HorizontalAlignment="Left">
						<TextBlock x:Name="BienvenidaText" Text="Bienvenido" FontSize="15" FontWeight="SemiBold" Foreground="#1F2E2C" />
						<TextBlock x:Name="FechaHoraText" Text="—" FontSize="11" Foreground="{StaticResource FarmaTextMutedBrush}" />
					</StackPanel>

					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
						<!-- Notificaciones: botón con contador y panel desplegable -->
						<Grid Margin="0,0,16,0">
							<ui:Button x:Name="NotificacionesButton" Appearance="Transparent" Icon="{ui:SymbolIcon Alert24}"
							           Content="Notificaciones" Click="Notificaciones_Click" />
							<Border x:Name="NotificacionesBadge" Visibility="Collapsed" IsHitTestVisible="False"
							        Background="#D64550" CornerRadius="9" MinWidth="18" Height="18" Padding="5,0"
							        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,-4,0,0">
								<TextBlock x:Name="NotificacionesCantidadText" Foreground="White" FontSize="10.5" FontWeight="Bold"
								           HorizontalAlignment="Center" VerticalAlignment="Center" />
							</Border>

							<Popup x:Name="NotificacionesPopup" PlacementTarget="{Binding ElementName=NotificacionesButton}"
							       Placement="Bottom" HorizontalOffset="-230" VerticalOffset="6"
							       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
								<Border Width="400" Margin="10" Padding="16,14" Background="White" CornerRadius="10"
								        BorderBrush="#E3ECEA" BorderThickness="1">
									<Border.Effect>
										<DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.18" />
									</Border.Effect>
									<StackPanel>
										<DockPanel Margin="0,0,0,12">
											<TextBlock x:Name="NotificacionesResumenText" DockPanel.Dock="Right" FontSize="11.5"
											           Foreground="{StaticResource FarmaTextMutedBrush}" VerticalAlignment="Center" />
											<TextBlock Text="Notificaciones" FontSize="15" FontWeight="SemiBold" Foreground="#1F2E2C" />
										</DockPanel>

										<TextBlock x:Name="SinNotificacionesText" Visibility="Collapsed" TextWrapping="Wrap"
										           Text="Todo en orden: no hay avisos de stock ni recetas pendientes."
										           FontSize="12.5" Foreground="{StaticResource FarmaTextMutedBrush}" Margin="0,4,0,6" />

										<ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
											<ItemsControl x:Name="NotificacionesList">
												<ItemsControl.ItemTemplate>
													<DataTemplate>
														<Border Background="{Binding ColorFondo}" CornerRadius="8" Padding="12,10" Margin="0,0,0,8"
														        Cursor="Hand" MouseLeftButtonUp="Notificacion_Click">
															<Grid>
																<Grid.ColumnDefinitions>
																	<ColumnDefinition Width="Auto" />
																	<ColumnDefinition Width="*" />
																</Grid.ColumnDefinitions>
																<Ellipse Width="9" Height="9" Fill="{Binding ColorAcento}" VerticalAlignment="Top" Margin="0,5,10,0" />
																<StackPanel Grid.Column="1">
																	<TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" FontSize="13" Foreground="#1F2E2C" />
																	<TextBlock Text="{Binding Detalle}" FontSize="11.5" Foreground="#4A5A58" TextWrapping="Wrap" Margin="0,2,0,4" />
																	<TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding ColorAcento}">
																		<Run Text="{Binding Accion, Mode=OneWay}" /><Run Text=" →" />
																	</TextBlock>
																</StackPanel>
															</Grid>
														</Border>
													</DataTemplate>
												</ItemsControl.ItemTemplate>
											</ItemsControl>
										</ScrollViewer>
									</StackPanel>
								</Border>
							</Popup>
						</Grid>
						<ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon QuestionCircle24}" Content="Ayuda" Margin="0,0,16,0" />
						<!-- Mi perfil: avatar + nombre del usuario logueado -->
						<ui:Button Appearance="Transparent" Padding="6,4" Margin="0,0,16,0"
                                   ToolTip="Mi perfil" Click="MiPerfil_Click">
							<StackPanel Orientation="Horizontal">
								<compartido:AvatarUsuario x:Name="AvatarEncabezado" Width="32" Height="32" />
								<StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
									<TextBlock x:Name="NombreUsuarioText" FontSize="12.5" FontWeight="SemiBold" Foreground="#1F2E2C" />
									<TextBlock Text="Mi perfil" FontSize="10.5" Foreground="{StaticResource FarmaTextMutedBrush}" />
								</StackPanel>
							</StackPanel>
						</ui:Button>
						<ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon SignOut24}" Content="Cerrar sesión" Click="CerrarSesion_Click" />
					</StackPanel>
				</Grid>
			</Border>

			<Frame x:Name="RootFrame" Grid.Row="1" NavigationUIVisibility="Hidden" />
		</Grid>
	</Grid>
</ui:FluentWindow>