<Page x:Class="FarmaGest.UI.Views.Farmaceutico.NuevaVentaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:h="clr-namespace:FarmaGest.UI.Helpers"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Nueva venta">

	<Page.Resources>
		<ResourceDictionary Source="/FarmaGest.UI;component/Views/Farmaceutico/EstilosFarmaceutico.xaml" />
	</Page.Resources>


	<Grid Margin="26,20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="340" />
		</Grid.ColumnDefinitions>

		<!-- ===================== ENCABEZADO ===================== -->
		<StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,16">
			<ui:HyperlinkButton Content="← Volver a mis ventas" Padding="0" Margin="0,0,0,6" Click="Volver_Click" />
			<TextBlock Text="Nueva venta" Style="{StaticResource PageTitleText}" />
			<TextBlock Text="Cargá los productos y, si corresponde, la receta validada. Al terminar, la venta se envía a caja para su cobro."
                       Style="{StaticResource PageSubtitleText}" />
		</StackPanel>

		<!-- ===================== COLUMNA IZQUIERDA ===================== -->
		<ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
			<StackPanel>

				<!-- 1. Tipo de venta -->
				<Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
					<StackPanel>
						<TextBlock Text="1. Tipo de venta" FontWeight="SemiBold" Margin="0,0,0,10" />
						<StackPanel Orientation="Horizontal">
							<RadioButton x:Name="TipoLibreRadio" GroupName="TipoVenta" Content="Venta libre" Margin="0,0,24,0"
                                         Checked="Tipo_Changed" />
							<RadioButton x:Name="TipoRecetaRadio" GroupName="TipoVenta" Content="Con receta / obra social" IsChecked="True"
                                         Checked="Tipo_Changed" />
						</StackPanel>
					</StackPanel>
				</Border>

				<!-- 2. Receta y cobertura (solo si la venta es con receta) -->
				<Border Style="{StaticResource CardStyle}" Margin="0,0,0,12"
                        Visibility="{Binding IsChecked, ElementName=TipoRecetaRadio, Converter={StaticResource BoolToVis}}">
					<StackPanel>
						<TextBlock Text="2. Receta y cobertura" FontWeight="SemiBold" Margin="0,0,0,10" />

						<TextBlock Text="Receta validada" Style="{StaticResource FieldLabelText}" />
						<ComboBox x:Name="RecetaCombo" DisplayMemberPath="TextoCombo" SelectionChanged="Receta_Changed" />

						<TextBlock x:Name="SinRecetasText" Visibility="Collapsed" Margin="0,8,0,0" TextWrapping="Wrap"
                                   FontSize="11.5" Foreground="{StaticResource FarmaWarningBrush}"
                                   Text="No hay recetas validadas disponibles. Validá una receta en «Validación de recetas» o hacé una venta libre." />

						<!-- Datos de la receta seleccionada -->
						<Border Background="#F4F7F6" CornerRadius="8" Padding="14,12" Margin="0,12,0,0"
                                DataContext="{Binding SelectedItem, ElementName=RecetaCombo}">
							<UniformGrid Columns="4">
								<StackPanel>
									<TextBlock Text="Afiliado" Style="{StaticResource FieldLabelText}" />
									<TextBlock Text="{Binding Paciente, FallbackValue='—'}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
									<TextBlock Text="{Binding NumeroAfiliado, StringFormat='N° {0}', FallbackValue=''}" FontSize="11" Foreground="{StaticResource FarmaTextMutedBrush}" />
								</StackPanel>
								<StackPanel>
									<TextBlock Text="Obra social / plan" Style="{StaticResource FieldLabelText}" />
									<TextBlock Text="{Binding ObraSocial, FallbackValue='—'}" FontSize="12.5" FontWeight="SemiBold" />
									<TextBlock Text="{Binding Plan, FallbackValue=''}" FontSize="11" Foreground="{StaticResource FarmaTextMutedBrush}" />
								</StackPanel>
								<StackPanel>
									<TextBlock Text="Médico" Style="{StaticResource FieldLabelText}" />
									<TextBlock Text="{Binding Medico, FallbackValue='—'}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
									<TextBlock Text="{Binding Matricula, FallbackValue=''}" FontSize="11" Foreground="{StaticResource FarmaTextMutedBrush}" />
								</StackPanel>
								<StackPanel>
									<TextBlock Text="Vigencia" Style="{StaticResource FieldLabelText}" />
									<TextBlock Text="{Binding FechaVencimiento, StringFormat='Hasta {0:dd/MM/yyyy}', FallbackValue='—'}" FontSize="12.5" FontWeight="SemiBold" />
									<TextBlock Text="{Binding Estado, FallbackValue=''}" FontSize="11" Foreground="{StaticResource FarmaSuccessBrush}" />
								</StackPanel>
							</UniformGrid>
						</Border>

						<StackPanel Orientation="Horizontal" Margin="0,10,0,0">
							<ui:SymbolIcon Symbol="Info24" FontSize="15" Foreground="{StaticResource FarmaTextMutedBrush}" />
							<TextBlock Text="Los medicamentos de la receta se agregan solos al detalle con el % de cobertura del plan."
                                       FontSize="11.5" Foreground="{StaticResource FarmaTextMutedBrush}" Margin="6,0,0,0" />
						</StackPanel>
					</StackPanel>
				</Border>

				<!-- 3. Productos -->
				<Border Style="{StaticResource CardStyle}">
					<StackPanel>
						<TextBlock Text="3. Productos" FontWeight="SemiBold" Margin="0,0,0,10" />

						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="90" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0" Margin="0,0,8,0">
								<TextBlock Text="Producto (escribí para buscar)" Style="{StaticResource FieldLabelText}" />
								<ComboBox x:Name="ProductoCombo" IsEditable="True" IsTextSearchEnabled="True"
                                          TextSearch.TextPath="Descripcion">
									<ComboBox.ItemTemplate>
										<DataTemplate>
											<TextBlock Text="{Binding TextoCombo}" />
										</DataTemplate>
									</ComboBox.ItemTemplate>
								</ComboBox>
							</StackPanel>
							<StackPanel Grid.Column="1" Margin="0,0,8,0">
								<TextBlock Text="Cantidad" Style="{StaticResource FieldLabelText}" />
								<TextBox x:Name="CantidadText" Text="1" h:ValidacionEntrada.Tipo="Entero" MaxLength="3" />
							</StackPanel>
							<ui:Button Grid.Column="2" Content="Agregar" Appearance="Primary" Icon="{ui:SymbolIcon Add24}"
                                       VerticalAlignment="Bottom" Click="Agregar_Click" />
						</Grid>

						<TextBlock x:Name="MensajeText" Foreground="{StaticResource FarmaDangerBrush}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />

						<DataGrid x:Name="DetalleGrid" Margin="0,8,0,0"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="None"
                                  RowHeight="40" Background="Transparent" BorderThickness="0">
							<DataGrid.Columns>
								<DataGridTextColumn Header="Producto" Binding="{Binding Producto}" Width="2*" />
								<DataGridTextColumn Header="Origen" Binding="{Binding Origen}" Width="80" />
								<DataGridTextColumn Header="Cant." Binding="{Binding Cantidad}" Width="55" />
								<DataGridTextColumn Header="P. unit." Binding="{Binding PrecioUnitario, StringFormat='$ {0:N2}'}" Width="*" />
								<DataGridTextColumn Header="Cobertura" Binding="{Binding CoberturaTexto}" Width="80" />
								<DataGridTextColumn Header="Descuento" Binding="{Binding Descuento, StringFormat='- $ {0:N2}'}" Width="*" />
								<DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat='$ {0:N2}'}" Width="*" />
								<DataGridTemplateColumn Width="50">
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate>
											<ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon Delete24}" Padding="6"
                                                       ToolTip="Quitar producto" Tag="{Binding}" Click="Quitar_Click" />
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>
							</DataGrid.Columns>
						</DataGrid>

						<!-- Aviso de producto con receta en venta libre -->
						<Border Background="#FDF3E1" CornerRadius="8" Padding="12,8" Margin="0,10,0,0"
                                Visibility="{Binding IsChecked, ElementName=TipoLibreRadio, Converter={StaticResource BoolToVis}}">
							<StackPanel Orientation="Horizontal">
								<ui:SymbolIcon Symbol="Warning24" FontSize="15" Foreground="#9A6B10" />
								<TextBlock Text="En venta libre solo se muestran los productos que no requieren receta."
                                           FontSize="11.5" Foreground="#9A6B10" Margin="6,0,0,0" />
							</StackPanel>
						</Border>
					</StackPanel>
				</Border>
			</StackPanel>
		</ScrollViewer>

		<!-- ===================== COLUMNA DERECHA: RESUMEN ===================== -->
		<Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
			<StackPanel>
				<TextBlock Text="Resumen de la venta" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14" />

				<Grid Margin="0,0,0,8">
					<TextBlock Text="Productos" Foreground="{StaticResource FarmaTextMutedBrush}" />
					<TextBlock x:Name="CantidadItemsText" Text="0" HorizontalAlignment="Right" />
				</Grid>
				<Grid Margin="0,0,0,8">
					<TextBlock Text="Subtotal" Foreground="{StaticResource FarmaTextMutedBrush}" />
					<TextBlock x:Name="SubtotalText" Text="$ 0,00" HorizontalAlignment="Right" />
				</Grid>
				<Grid Margin="0,0,0,12">
					<TextBlock Text="Descuento obra social" Foreground="{StaticResource FarmaTextMutedBrush}" />
					<TextBlock x:Name="DescuentoText" Text="- $ 0,00" HorizontalAlignment="Right"
                               Foreground="{StaticResource FarmaPrimaryBrush}" />
				</Grid>

				<Border BorderBrush="#E7ECEB" BorderThickness="0,1,0,0" Padding="0,12,0,0">
					<Grid>
						<TextBlock Text="Total a pagar" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
						<TextBlock x:Name="TotalText" Text="$ 0,00" FontSize="24" FontWeight="Bold" HorizontalAlignment="Right" />
					</Grid>
				</Border>

				<Border Background="#F4F7F6" CornerRadius="8" Padding="12,10" Margin="0,16,0,16">
					<TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource FarmaTextMutedBrush}"
                               Text="Al enviar, la venta queda como «Pendiente de cobro» y aparece en Preventas del cajero. El stock se descuenta cuando el cajero la cobra." />
				</Border>

				<ui:Button x:Name="EnviarButton" Content="Enviar a caja" Appearance="Primary" Icon="{ui:SymbolIcon Send24}"
                           HorizontalAlignment="Stretch" Height="40" Click="EnviarACaja_Click" />
				<ui:Button Content="Cancelar venta" Appearance="Secondary"
                           HorizontalAlignment="Stretch" Margin="0,8,0,0" Click="Volver_Click" />
			</StackPanel>
		</Border>
	</Grid>
</Page>
