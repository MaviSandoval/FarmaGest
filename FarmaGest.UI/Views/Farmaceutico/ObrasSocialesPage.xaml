<Page x:Class="FarmaGest.UI.Views.Farmaceutico.ObrasSocialesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:h="clr-namespace:FarmaGest.UI.Helpers"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Obras sociales">

	<Page.Resources>
		<ResourceDictionary Source="/FarmaGest.UI;component/Views/Farmaceutico/EstilosFarmaceutico.xaml" />
	</Page.Resources>


	<Grid Margin="26,20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!-- ===================== ENCABEZADO ===================== -->
		<StackPanel Grid.Row="0" Margin="0,0,0,16">
			<TextBlock Text="Obras sociales y afiliados" Style="{StaticResource PageTitleText}" />
			<TextBlock Text="Verificá si un paciente está afiliado y activo, y qué cubre cada plan."
                       Style="{StaticResource PageSubtitleText}" />
		</StackPanel>

		<!-- ===================== CONSULTA DE AFILIADO ===================== -->
		<Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
			<StackPanel>
				<TextBlock Text="Consultar afiliado" FontWeight="SemiBold" Margin="0,0,0,10" />
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<ui:TextBox Grid.Column="0" PlaceholderText="N° de afiliado o apellido"
                                Icon="{ui:SymbolIcon Search24}" Margin="0,0,8,0" Text="Pérez"
                                h:ValidacionEntrada.Tipo="Alfanumerico" MaxLength="30" />
					<ui:Button Grid.Column="1" Content="Buscar" Appearance="Primary" />
				</Grid>

				<DataGrid x:Name="AfiliadosGrid" Margin="0,10,0,0"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="None"
                          RowHeight="36" Background="Transparent" BorderThickness="0">
					<DataGrid.Columns>
						<DataGridTextColumn Header="Afiliado" Binding="{Binding Nombre}" Width="1.5*" />
						<DataGridTextColumn Header="N° afiliado" Binding="{Binding NumeroAfiliado}" Width="*" />
						<DataGridTextColumn Header="Obra social" Binding="{Binding ObraSocial}" Width="*" />
						<DataGridTextColumn Header="Plan" Binding="{Binding Plan}" Width="*" />
						<DataGridTemplateColumn Header="Estado" Width="100">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Border Style="{StaticResource EstadoBadge}">
										<TextBlock Text="{Binding Estado}" />
									</Border>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
					</DataGrid.Columns>
				</DataGrid>
			</StackPanel>
		</Border>

		<!-- ===================== OBRAS SOCIALES → PLANES → COBERTURAS ===================== -->
		<Grid Grid.Row="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="1.4*" />
			</Grid.ColumnDefinitions>

			<!-- Obras sociales -->
			<Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
				<DockPanel>
					<TextBlock DockPanel.Dock="Top" Text="Obras sociales" FontWeight="SemiBold" Margin="0,0,0,10" />
					<ListBox x:Name="ObrasSocialesList" BorderThickness="0" Background="Transparent">
						<ListBox.ItemTemplate>
							<DataTemplate>
								<StackPanel Margin="0,4">
									<TextBlock Text="{Binding Nombre}" FontSize="13" FontWeight="SemiBold" />
									<TextBlock FontSize="11" Foreground="{StaticResource FarmaTextMutedBrush}">
										<Run Text="Cód." />
										<Run Text="{Binding Codigo, Mode=OneWay}" />
										<Run Text="·" />
										<Run Text="{Binding Telefono, Mode=OneWay}" />
									</TextBlock>
								</StackPanel>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</DockPanel>
			</Border>

			<!-- Planes de la obra social seleccionada -->
			<Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0">
				<DockPanel>
					<TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,10">
						<Run Text="Planes de" />
						<Run Text="{Binding SelectedItem.Nombre, ElementName=ObrasSocialesList, Mode=OneWay}" />
					</TextBlock>
					<ListBox x:Name="PlanesList" BorderThickness="0" Background="Transparent"
                             ItemsSource="{Binding SelectedItem.Planes, ElementName=ObrasSocialesList}">
						<ListBox.ItemTemplate>
							<DataTemplate>
								<StackPanel Margin="0,4">
									<TextBlock Text="{Binding Nombre}" FontSize="13" FontWeight="SemiBold" />
									<TextBlock Text="{Binding Descripcion}" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{StaticResource FarmaTextMutedBrush}" />
								</StackPanel>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</DockPanel>
			</Border>

			<!-- Coberturas del plan seleccionado -->
			<Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
				<DockPanel>
					<TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,10">
						<Run Text="Cobertura del plan" />
						<Run Text="{Binding SelectedItem.Nombre, ElementName=PlanesList, Mode=OneWay}" />
					</TextBlock>
					<DataGrid AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="None"
                              RowHeight="36" Background="Transparent" BorderThickness="0"
                              ItemsSource="{Binding SelectedItem.Coberturas, ElementName=PlanesList}">
						<DataGrid.Columns>
							<DataGridTextColumn Header="Producto" Binding="{Binding Producto}" Width="2*" />
							<DataGridTextColumn Header="Cobertura" Binding="{Binding Porcentaje, StringFormat='{}{0:0} %'}" Width="*" />
						</DataGrid.Columns>
					</DataGrid>
				</DockPanel>
			</Border>
		</Grid>
	</Grid>
</Page>
