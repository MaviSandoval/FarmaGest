<Page x:Class="FarmaGest.UI.Views.Farmaceutico.ProductosFarmaceuticoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Productos">

	<Page.Resources>
		<ResourceDictionary Source="/FarmaGest.UI;component/Views/Farmaceutico/EstilosFarmaceutico.xaml" />
	</Page.Resources>


	<Grid Margin="26,20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!-- ===================== ENCABEZADO ===================== -->
		<StackPanel Grid.Row="0" Margin="0,0,0,16">
			<TextBlock Text="Catálogo de productos" Style="{StaticResource PageTitleText}" />
			<TextBlock Text="Consultá precio, stock y cobertura por obra social. El alta y la edición de productos las hace el Administrador."
                       Style="{StaticResource PageSubtitleText}" />
		</StackPanel>

		<!-- ===================== FILTROS ===================== -->
		<Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16" Padding="18,14">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="240" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<ui:TextBox Grid.Column="0" PlaceholderText="Buscar producto por nombre..."
                            Icon="{ui:SymbolIcon Search24}" Margin="0,0,12,0" MaxLength="60" />
				<ComboBox Grid.Column="1" SelectedIndex="0" Margin="0,0,12,0">
					<ComboBoxItem Content="Todas las categorías" />
					<ComboBoxItem Content="Analgésicos y Antipiréticos" />
					<ComboBoxItem Content="Antiinflamatorios" />
					<ComboBoxItem Content="Antibióticos" />
					<ComboBoxItem Content="Antialérgicos" />
					<ComboBoxItem Content="Antigripales y Respiratorios" />
				</ComboBox>
				<CheckBox Grid.Column="2" Content="Solo requieren receta" VerticalAlignment="Center" />
			</Grid>
		</Border>

		<!-- ===================== LISTADO + DETALLE ===================== -->
		<Grid Grid.Row="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="340" />
			</Grid.ColumnDefinitions>

			<Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,16,0">
				<DataGrid x:Name="ProductosGrid"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" HeadersVisibility="Column"
                          GridLinesVisibility="None" RowHeight="38"
                          Background="Transparent" BorderThickness="0">
					<DataGrid.Columns>
						<DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="2*" />
						<DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="1.5*" />
						<DataGridTextColumn Header="Precio" Binding="{Binding Precio, StringFormat='$ {0:N2}'}" Width="*" />
						<DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="70" />
						<DataGridTextColumn Header="Receta" Binding="{Binding RequiereRecetaTexto}" Width="70" />
						<DataGridTemplateColumn Header="Estado" Width="100">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Border Style="{StaticResource EstadoBadge}">
										<TextBlock Text="{Binding Estado}" />
									</Border>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
					</DataGrid.Columns>
				</DataGrid>
			</Border>

			<!-- Detalle del producto seleccionado -->
			<Border Grid.Column="1" Style="{StaticResource CardStyle}" VerticalAlignment="Top"
                    DataContext="{Binding SelectedItem, ElementName=ProductosGrid}">
				<StackPanel>
					<TextBlock Text="{Binding Descripcion}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
					<TextBlock Text="{Binding Categoria}" FontSize="12" Foreground="{StaticResource FarmaTextMutedBrush}" Margin="0,2,0,14" />

					<UniformGrid Columns="3" Margin="0,0,0,16">
						<StackPanel>
							<TextBlock Text="Precio" Style="{StaticResource FieldLabelText}" />
							<TextBlock Text="{Binding Precio, StringFormat='$ {0:N2}'}" FontWeight="SemiBold" />
						</StackPanel>
						<StackPanel>
							<TextBlock Text="Stock" Style="{StaticResource FieldLabelText}" />
							<TextBlock Text="{Binding Stock}" FontWeight="SemiBold" />
						</StackPanel>
						<StackPanel>
							<TextBlock Text="Receta" Style="{StaticResource FieldLabelText}" />
							<TextBlock Text="{Binding RequiereRecetaTexto}" FontWeight="SemiBold" />
						</StackPanel>
					</UniformGrid>

					<TextBlock Text="COBERTURA POR OBRA SOCIAL" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{StaticResource FarmaTextMutedBrush}" Margin="0,0,0,6" />
					<ItemsControl ItemsSource="{Binding Coberturas}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border BorderBrush="#E7ECEB" BorderThickness="0,0,0,1" Padding="0,7">
									<Grid>
										<TextBlock Text="{Binding Plan}" FontSize="12.5" />
										<TextBlock Text="{Binding Porcentaje, StringFormat='{}{0:0} %'}" HorizontalAlignment="Right"
                                                   FontWeight="SemiBold" Foreground="{StaticResource FarmaPrimaryBrush}" />
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
					<TextBlock Text="Los planes que no figuran no cubren este producto." FontSize="11"
                               Foreground="{StaticResource FarmaTextMutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
				</StackPanel>
			</Border>
		</Grid>
	</Grid>
</Page>
