<Page x:Class="FarmaGest.UI.Views.Farmaceutico.ReportesFarmaceuticoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:compartido="clr-namespace:FarmaGest.UI.Views.Compartido"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      Title="Reportes">

	<!-- Reportes del Farmacéutico: cruzan varias tablas y se filtran por período -->

	<Page.Resources>
		<ResourceDictionary Source="/FarmaGest.UI;component/Views/Farmaceutico/EstilosFarmaceutico.xaml" />
	</Page.Resources>

	<ScrollViewer x:Name="ScrollPrincipal" VerticalScrollBarVisibility="Auto">
	<Grid Margin="26,20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!-- ===================== ENCABEZADO ===================== -->
		<Grid Grid.Row="0" Margin="0,0,0,16">
			<StackPanel>
				<TextBlock Text="Reportes" Style="{StaticResource PageTitleText}" />
				<TextBlock Text="Resumen de toda la farmacia y detalle de ventas, productos, recetas y períodos."
                           Style="{StaticResource PageSubtitleText}" />
			</StackPanel>
			<StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
				<ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon ArrowDownload24}"
                           Content="Exportar PDF" Click="ExportarPdf_Click" Margin="0,0,8,0"
                           ToolTip="Exporta la pestaña de detalle que estés viendo" />
				<ui:Button Appearance="Primary" Icon="{ui:SymbolIcon ArrowDownload24}"
                           Content="Exportar Excel" Click="ExportarCsv_Click"
                           ToolTip="Exporta la pestaña de detalle que estés viendo (CSV, se abre con Excel)" />
			</StackPanel>
		</Grid>

		<!-- ===================== FILTRO DE PERÍODO ===================== -->
		<Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16" Padding="18,14">
			<StackPanel Orientation="Horizontal">
				<StackPanel Margin="0,0,12,0">
					<TextBlock Text="Desde" Style="{StaticResource FieldLabelText}" />
					<DatePicker x:Name="DesdePicker" Width="160" />
				</StackPanel>
				<StackPanel Margin="0,0,12,0">
					<TextBlock Text="Hasta" Style="{StaticResource FieldLabelText}" />
					<DatePicker x:Name="HastaPicker" Width="160" />
				</StackPanel>
				<ui:Button Content="Generar" Appearance="Primary" Icon="{ui:SymbolIcon ArrowSync24}"
                           VerticalAlignment="Bottom" Click="Generar_Click" />

				<Border Width="1" Background="#E3ECEA" Margin="18,4,18,0" />

				<StackPanel>
					<TextBlock Text="Accesos rápidos" Style="{StaticResource FieldLabelText}" />
					<StackPanel Orientation="Horizontal">
						<ui:Button Content="Últimos 7 días" Appearance="Secondary" Tag="7" Click="Rapido_Click" Margin="0,0,6,0" />
						<ui:Button Content="Últimos 30 días" Appearance="Secondary" Tag="30" Click="Rapido_Click" Margin="0,0,6,0" />
						<ui:Button Content="Trimestre" Appearance="Secondary" Tag="90" Click="Rapido_Click" />
					</StackPanel>
				</StackPanel>
			</StackPanel>
		</Border>

		<!-- ===================== RESUMEN DEL PERÍODO ===================== -->
		<compartido:ResumenReportes x:Name="Resumen" Grid.Row="2" />

		<!-- ===================== DETALLE (tablas exportables) ===================== -->
		<Border Grid.Row="3" Style="{StaticResource CardStyle}">
			<StackPanel>
			<TextBlock Text="Detalle" FontSize="16" FontWeight="SemiBold" Foreground="#1F2E2C" Margin="2,0,0,2" />
			<TextBlock Text="Tablas completas de cada reporte. Exportar PDF / Excel descarga la pestaña que estés viendo."
			           FontSize="12" Foreground="#6B7B79" Margin="2,0,0,10" />
			<TabControl x:Name="ReportesTabs">

				<!-- Ventas del farmacéutico por obra social -->
				<TabItem Header="Ventas por obra social">
					<Grid Margin="0,12,0,0">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>
						<DataGrid x:Name="ObraSocialGrid" Grid.Row="1"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="None"
                              RowHeight="38" Background="Transparent" BorderThickness="0">
						<DataGrid.Columns>
							<DataGridTextColumn Header="Obra social" Binding="{Binding ObraSocial}" Width="1.4*" />
							<DataGridTextColumn Header="Ventas" Binding="{Binding Ventas}" Width="*" />
							<DataGridTextColumn Header="Total vendido" Binding="{Binding TotalVendido, StringFormat='$ {0:N2}'}" Width="*" />
							<DataGridTextColumn Header="Cubierto por la obra social" Binding="{Binding TotalCubierto, StringFormat='$ {0:N2}'}" Width="1.3*" />
							<DataGridTextColumn Header="Pagado por el cliente" Binding="{Binding PagadoCliente, StringFormat='$ {0:N2}'}" Width="1.2*" />
						</DataGrid.Columns>
					</DataGrid>
					</Grid>
				</TabItem>

				<!-- Productos que más vendió el farmacéutico -->
				<TabItem Header="Productos más vendidos">
					<Grid Margin="0,12,0,0">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>
						<DataGrid x:Name="ProductosGrid" Grid.Row="1"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="None"
                              RowHeight="38" Background="Transparent" BorderThickness="0">
						<DataGrid.Columns>
							<DataGridTextColumn Header="#" Binding="{Binding Puesto}" Width="40" />
							<DataGridTextColumn Header="Producto" Binding="{Binding Producto}" Width="2*" />
							<DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="1.3*" />
							<DataGridTextColumn Header="Unidades" Binding="{Binding Unidades}" Width="*" />
							<DataGridTextColumn Header="Total vendido" Binding="{Binding Total, StringFormat='$ {0:N2}'}" Width="*" />
						</DataGrid.Columns>
					</DataGrid>
					</Grid>
				</TabItem>

				<!-- Recetas recibidas por obra social y estado (según fecha de emisión) -->
				<TabItem Header="Recetas por obra social">
					<Grid Margin="0,12,0,0">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>
						<Border x:Name="RecetasChartCard" Style="{StaticResource GraficoCard}">
							<StackPanel>
								<TextBlock Text="Estado de las recetas recibidas" Style="{StaticResource GraficoTitulo}" />
								<lvc:PieChart x:Name="RecetasChart" Height="210" />
							</StackPanel>
						</Border>
						<DataGrid x:Name="RecetasGrid" Grid.Row="1"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="None"
                              RowHeight="38" Background="Transparent" BorderThickness="0">
						<DataGrid.Columns>
							<DataGridTextColumn Header="Obra social" Binding="{Binding ObraSocial}" Width="1.4*" />
							<DataGridTextColumn Header="Recibidas" Binding="{Binding Total}" Width="*" />
							<DataGridTextColumn Header="Pendientes" Binding="{Binding Pendientes}" Width="*" />
							<DataGridTextColumn Header="Validadas" Binding="{Binding Validadas}" Width="*" />
							<DataGridTextColumn Header="Rechazadas" Binding="{Binding Rechazadas}" Width="*" />
							<DataGridTextColumn Header="Usadas en ventas" Binding="{Binding Usadas}" Width="*" />
						</DataGrid.Columns>
					</DataGrid>
					</Grid>
				</TabItem>
				<!-- Ventas por período (semana / mes) -->
				<TabItem Header="Ventas por período">
					<Grid Margin="0,12,0,0">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>
						<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
							<TextBlock Text="Agrupar por" VerticalAlignment="Center" Margin="0,0,8,0" />
							<ComboBox x:Name="AgrupacionCombo" Width="140" SelectedIndex="0"
                                      SelectionChanged="Agrupacion_Changed">
								<ComboBoxItem Content="Semana" />
								<ComboBoxItem Content="Mes" />
							</ComboBox>
						</StackPanel>
						<Border x:Name="PeriodoChartCard" Grid.Row="1" Style="{StaticResource GraficoCard}">
							<StackPanel>
								<TextBlock Text="Total vendido y cantidad de ventas por período" Style="{StaticResource GraficoTitulo}" />
								<lvc:CartesianChart x:Name="PeriodoChart" Height="210" />
							</StackPanel>
						</Border>
						<DataGrid x:Name="PeriodoGrid" Grid.Row="2"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="None"
                                  RowHeight="38" Background="Transparent" BorderThickness="0">
							<DataGrid.Columns>
								<DataGridTextColumn Header="Período" Binding="{Binding Periodo}" Width="1.8*" />
								<DataGridTextColumn Header="Ventas" Binding="{Binding Ventas}" Width="0.7*" />
								<DataGridTextColumn Header="Con receta" Binding="{Binding ConReceta}" Width="0.8*" />
								<DataGridTextColumn Header="Total vendido" Binding="{Binding TotalVendido, StringFormat='$ {0:N2}'}" Width="*" />
								<DataGridTextColumn Header="Cubierto por OS" Binding="{Binding TotalCubierto, StringFormat='$ {0:N2}'}" Width="*" />
								<DataGridTextColumn Header="Pagado por el cliente" Binding="{Binding PagadoCliente, StringFormat='$ {0:N2}'}" Width="*" />
								<DataGridTextColumn Header="Ticket promedio" Binding="{Binding TicketPromedio, StringFormat='$ {0:N2}'}" Width="*" />
							</DataGrid.Columns>
						</DataGrid>
					</Grid>
				</TabItem>
			</TabControl>
			</StackPanel>
		</Border>
	</Grid>
	</ScrollViewer>
</Page>
