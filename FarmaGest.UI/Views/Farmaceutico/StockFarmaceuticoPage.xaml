<Page x:Class="FarmaGest.UI.Views.Farmaceutico.StockFarmaceuticoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Stock">

	<Page.Resources>
		<ResourceDictionary Source="/FarmaGest.UI;component/Views/Farmaceutico/EstilosFarmaceutico.xaml" />
	</Page.Resources>


	<Grid Margin="26,20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!-- ===================== ENCABEZADO ===================== -->
		<StackPanel Grid.Row="0" Margin="0,0,0,16">
			<TextBlock Text="Control de stock" Style="{StaticResource PageTitleText}" />
			<TextBlock Text="Revisá qué productos están por debajo del mínimo para avisar al Administrador."
                       Style="{StaticResource PageSubtitleText}" />
		</StackPanel>

		<!-- ===================== KPIs ===================== -->
		<UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
			<Border Style="{StaticResource CardStyle}" Margin="0,0,8,0">
				<StackPanel>
					<TextBlock Text="Productos activos" Style="{StaticResource KpiLabelText}" />
					<TextBlock x:Name="ActivosText" Text="0" Style="{StaticResource KpiValueText}" />
				</StackPanel>
			</Border>
			<Border Style="{StaticResource CardStyle}" Margin="4,0">
				<StackPanel>
					<TextBlock Text="Stock normal" Style="{StaticResource KpiLabelText}" />
					<TextBlock x:Name="NormalText" Text="0" Style="{StaticResource KpiValueText}" Foreground="{StaticResource FarmaSuccessBrush}" />
				</StackPanel>
			</Border>
			<Border Style="{StaticResource CardStyle}" Margin="4,0">
				<StackPanel>
					<TextBlock Text="Stock bajo" Style="{StaticResource KpiLabelText}" />
					<TextBlock x:Name="BajoText" Text="0" Style="{StaticResource KpiValueText}" Foreground="{StaticResource FarmaWarningBrush}" />
				</StackPanel>
			</Border>
			<Border Style="{StaticResource CardStyle}" Margin="8,0,0,0">
				<StackPanel>
					<TextBlock Text="Sin stock" Style="{StaticResource KpiLabelText}" />
					<TextBlock x:Name="SinStockText" Text="0" Style="{StaticResource KpiValueText}" Foreground="{StaticResource FarmaDangerBrush}" />
				</StackPanel>
			</Border>
		</UniformGrid>

		<!-- ===================== FILTROS ===================== -->
		<Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,16" Padding="18,14">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="200" />
				</Grid.ColumnDefinitions>
				<ui:TextBox Grid.Column="0" PlaceholderText="Buscar producto..."
                            Icon="{ui:SymbolIcon Search24}" Margin="0,0,12,0" MaxLength="60" />
				<ComboBox Grid.Column="1" SelectedIndex="0">
					<ComboBoxItem Content="Todos" />
					<ComboBoxItem Content="Normal" />
					<ComboBoxItem Content="Bajo" />
					<ComboBoxItem Content="Sin stock" />
				</ComboBox>
			</Grid>
		</Border>

		<!-- ===================== LISTADO ===================== -->
		<Border Grid.Row="3" Style="{StaticResource CardStyle}">
			<DataGrid x:Name="StockGrid"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="None"
                      RowHeight="38" Background="Transparent" BorderThickness="0">
				<DataGrid.Columns>
					<DataGridTextColumn Header="Producto" Binding="{Binding Descripcion}" Width="2*" />
					<DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="1.5*" />
					<DataGridTextColumn Header="Stock actual" Binding="{Binding Stock}" Width="*" />
					<DataGridTextColumn Header="Stock mínimo" Binding="{Binding StockMinimo}" Width="*" />
					<DataGridTemplateColumn Header="Estado" Width="120">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<Border Style="{StaticResource EstadoBadge}">
									<TextBlock Text="{Binding Estado}" />
								</Border>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
				</DataGrid.Columns>
			</DataGrid>
		</Border>
	</Grid>
</Page>
