<Page x:Class="FarmaGest.UI.Views.Farmaceutico.ValidacionRecetasPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:h="clr-namespace:FarmaGest.UI.Helpers"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Validación de recetas">

	<Page.Resources>
		<ResourceDictionary Source="/FarmaGest.UI;component/Views/Farmaceutico/EstilosFarmaceutico.xaml" />
	</Page.Resources>


	<Grid Margin="26,20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!-- ===================== ENCABEZADO ===================== -->
		<Grid Grid.Row="0" Margin="0,0,0,16">
			<StackPanel>
				<TextBlock Text="Validación de recetas" Style="{StaticResource PageTitleText}" />
				<TextBlock Text="Registrá la receta que trae el paciente, verificá vigencia y cobertura, y validala para usarla en una venta."
                           Style="{StaticResource PageSubtitleText}" />
			</StackPanel>
			<ui:Button HorizontalAlignment="Right" VerticalAlignment="Center"
                       Appearance="Primary" Icon="{ui:SymbolIcon Add24}"
                       Content="Registrar receta" Click="RegistrarReceta_Click" />
		</Grid>

		<!-- ===================== FILTROS ===================== -->
		<Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16" Padding="18,14">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="200" />
				</Grid.ColumnDefinitions>
				<ui:TextBox Grid.Column="0" PlaceholderText="Buscar por paciente, N° de afiliado o médico..."
                            Icon="{ui:SymbolIcon Search24}" Margin="0,0,12,0"
                            h:ValidacionEntrada.Tipo="Alfanumerico" MaxLength="60" />
				<ComboBox Grid.Column="1" SelectedIndex="1">
					<ComboBoxItem Content="Todas" />
					<ComboBoxItem Content="Pendientes" />
					<ComboBoxItem Content="Validadas" />
					<ComboBoxItem Content="Rechazadas" />
				</ComboBox>
			</Grid>
		</Border>

		<!-- ===================== LISTADO + DETALLE ===================== -->
		<Grid Grid.Row="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="390" />
			</Grid.ColumnDefinitions>

			<!-- Listado de recetas -->
			<Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,16,0">
				<DataGrid x:Name="RecetasGrid"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" HeadersVisibility="Column"
                          GridLinesVisibility="None" RowHeight="40"
                          Background="Transparent" BorderThickness="0">
					<DataGrid.Columns>
						<DataGridTextColumn Header="N°" Binding="{Binding Numero}" Width="60" />
						<DataGridTextColumn Header="Paciente" Binding="{Binding Paciente}" Width="1.4*" />
						<DataGridTextColumn Header="Obra social" Binding="{Binding ObraSocialPlan}" Width="1.3*" />
						<DataGridTextColumn Header="Médico" Binding="{Binding Medico}" Width="1.3*" />
						<DataGridTextColumn Header="Emisión" Binding="{Binding FechaEmision, StringFormat='dd/MM/yyyy'}" Width="90" />
						<DataGridTemplateColumn Header="Estado" Width="110">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Border Style="{StaticResource EstadoBadge}">
										<TextBlock Text="{Binding Estado}" />
									</Border>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
					</DataGrid.Columns>
				</DataGrid>
			</Border>

			<!-- Detalle de la receta seleccionada -->
			<Border Grid.Column="1" Style="{StaticResource CardStyle}"
                    DataContext="{Binding SelectedItem, ElementName=RecetasGrid}">
				<DockPanel LastChildFill="True">

					<!-- Encabezado del detalle -->
					<Grid DockPanel.Dock="Top" Margin="0,0,0,12">
						<TextBlock FontSize="15" FontWeight="SemiBold">
							<Run Text="Receta N°" />
							<Run Text="{Binding Numero, Mode=OneWay}" />
						</TextBlock>
						<Border Style="{StaticResource EstadoBadge}" HorizontalAlignment="Right">
							<TextBlock Text="{Binding Estado}" />
						</Border>
					</Grid>

					<!-- Botones de acción -->
					<StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
						<TextBlock Text="Observación (obligatoria si se rechaza)" Style="{StaticResource FieldLabelText}" />
						<ui:TextBox PlaceholderText="Ej.: receta vencida, falta firma del médico..." MaxLength="200" Margin="0,0,0,12" />
						<UniformGrid Columns="2">
							<ui:Button Content="Rechazar" Appearance="Danger" Icon="{ui:SymbolIcon Dismiss24}"
                                       HorizontalAlignment="Stretch" Margin="0,0,6,0" Click="Rechazar_Click" />
							<ui:Button Content="Validar" Appearance="Primary" Icon="{ui:SymbolIcon Checkmark24}"
                                       HorizontalAlignment="Stretch" Margin="6,0,0,0" Click="Validar_Click" />
						</UniformGrid>
						<ui:Button Content="Iniciar venta con esta receta" Appearance="Secondary"
                                   Icon="{ui:SymbolIcon Cart24}" HorizontalAlignment="Stretch"
                                   Margin="0,8,0,0" Click="IniciarVenta_Click" />
					</StackPanel>

					<!-- Contenido -->
					<ScrollViewer VerticalScrollBarVisibility="Auto">
						<StackPanel>

							<!-- Paciente -->
							<TextBlock Text="PACIENTE / AFILIADO" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource FarmaTextMutedBrush}" Margin="0,0,0,6" />
							<TextBlock Text="{Binding Paciente}" FontSize="13" FontWeight="SemiBold" />
							<TextBlock FontSize="12" Foreground="{StaticResource FarmaTextMutedBrush}">
								<Run Text="N° afiliado:" />
								<Run Text="{Binding NumeroAfiliado, Mode=OneWay}" />
							</TextBlock>
							<TextBlock Text="{Binding ObraSocialPlan}" FontSize="12" Margin="0,0,0,14" />

							<!-- Médico -->
							<TextBlock Text="MÉDICO" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource FarmaTextMutedBrush}" Margin="0,0,0,6" />
							<TextBlock Text="{Binding Medico}" FontSize="13" />
							<TextBlock FontSize="12" Foreground="{StaticResource FarmaTextMutedBrush}" Margin="0,0,0,14">
								<Run Text="Matrícula:" />
								<Run Text="{Binding Matricula, Mode=OneWay}" />
							</TextBlock>

							<!-- Fechas -->
							<UniformGrid Columns="2" Margin="0,0,0,14">
								<StackPanel>
									<TextBlock Text="EMISIÓN" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource FarmaTextMutedBrush}" />
									<TextBlock Text="{Binding FechaEmision, StringFormat='dd/MM/yyyy'}" FontSize="13" />
								</StackPanel>
								<StackPanel>
									<TextBlock Text="VENCIMIENTO" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource FarmaTextMutedBrush}" />
									<TextBlock Text="{Binding FechaVencimiento, StringFormat='dd/MM/yyyy'}" FontSize="13" />
								</StackPanel>
							</UniformGrid>

							<!-- Medicamentos -->
							<TextBlock Text="MEDICAMENTOS RECETADOS" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource FarmaTextMutedBrush}" Margin="0,0,0,6" />
							<ItemsControl ItemsSource="{Binding Medicamentos}" Margin="0,0,0,14">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border BorderBrush="#E7ECEB" BorderThickness="0,0,0,1" Padding="0,6">
											<Grid>
												<StackPanel>
													<TextBlock Text="{Binding Producto}" FontSize="12.5" />
													<TextBlock FontSize="11" Foreground="{StaticResource FarmaTextMutedBrush}">
														<Run Text="Cantidad:" />
														<Run Text="{Binding Cantidad, Mode=OneWay}" />
													</TextBlock>
												</StackPanel>
												<TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource FarmaPrimaryBrush}"
                                                           Text="{Binding CoberturaTexto}" />
											</Grid>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<!-- Verificaciones automáticas -->
							<TextBlock Text="VERIFICACIONES" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource FarmaTextMutedBrush}" Margin="0,0,0,6" />
							<ItemsControl ItemsSource="{Binding Verificaciones}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<StackPanel Orientation="Horizontal" Margin="0,3">
											<ui:SymbolIcon x:Name="Icono" Symbol="CheckmarkCircle24" FontSize="16"
                                                           Foreground="{StaticResource FarmaSuccessBrush}" />
											<TextBlock Text="{Binding Texto}" FontSize="12.5" Margin="8,0,0,0"
                                                       VerticalAlignment="Center" />
										</StackPanel>
										<DataTemplate.Triggers>
											<DataTrigger Binding="{Binding Ok}" Value="False">
												<Setter TargetName="Icono" Property="Symbol" Value="Warning24" />
												<Setter TargetName="Icono" Property="Foreground" Value="{StaticResource FarmaWarningBrush}" />
											</DataTrigger>
										</DataTemplate.Triggers>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</ScrollViewer>
				</DockPanel>
			</Border>
		</Grid>
	</Grid>
</Page>
